{
  "name": "@timui/html",
  "version": "0.0.1",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.mjs",
      "require": "./dist/manifest.js"
    },
    "./components/*": "./dist/components/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "tsx scripts/compile.ts",
    "prepublishOnly": "pnpm run build",
    "check:capabilities": "node --import tsx ../../scripts/check-html-capabilities.ts",
    "check:runtime": "pnpm run build && node --import tsx ../../scripts/goal-smoke-html-runtime.ts",
    "build": "node --import tsx ../../scripts/build-html-package.ts",
    "release": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zag-js/core": "^1.32.0",
    "@timui/core": "workspace:*"
  },
  "devDependencies": {
    "handlebars": "^4.7.8",
    "tsx": "^4.0.0"
  }
}
