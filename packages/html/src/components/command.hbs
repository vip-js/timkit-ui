<div data-slot="command" tabindex="-1" class="rounded-lg border border-input bg-background p-2">
  <input
    type="text"
    aria-label="Type a command..."
    aria-expanded="true"
    aria-controls="command-list"
    placeholder="Type a command..."
    class="{{commandInputVariants}}"
  />
  <div id="command-list" role="listbox" aria-label="Suggestions" class="mt-2 rounded-md bg-muted/40 p-1 text-sm">
    <div role="option" aria-selected="false" class="{{commandInputWrapperVariants}}">
      <span>Open Settings</span>
      <span data-slot="command-shortcut" class="text-xs text-muted-foreground" aria-hidden="true">⌘S</span>
    </div>
    <div role="option" aria-selected="false" class="{{commandInputWrapperVariants}}">
      <span>Create Project</span>
      <span data-slot="command-shortcut" class="text-xs text-muted-foreground" aria-hidden="true">⌘P</span>
    </div>
  </div>
</div>
