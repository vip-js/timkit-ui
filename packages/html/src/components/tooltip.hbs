<div data-slot="tooltip-root" data-state="closed" class="relative inline-flex">
  <button
    data-slot="tooltip-trigger"
    type="button"
    class="rounded-md border px-3 py-2 text-sm"
  >
    Hover for details
  </button>
  <div
    data-slot="tooltip-content"
    data-state="closed"
    hidden
    class="{{tooltipContentVariants}} absolute left-1/2 top-full z-50 mt-2 -translate-x-1/2 whitespace-nowrap"
  >
    Tooltip content
  </div>
</div>
