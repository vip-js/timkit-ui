<div data-slot="alert-dialog" class="{{alertDialogOverlayVariants}}">
  <div role="alertdialog" tabindex="-1" aria-modal="true" aria-labelledby="alert-dialog-title" aria-describedby="alert-dialog-description" class="{{alertDialogContentVariants}}">
    <p role="status">Opened</p>
    <h2 id="alert-dialog-title" class="{{alertDialogTitleVariants}}">Are you absolutely sure?</h2>
    <p id="alert-dialog-description" class="{{alertDialogDescriptionVariants}}">
      This action cannot be undone.
    </p>
    <div class="mt-4 flex justify-end gap-2">
      <button type="button" class="rounded-md border px-3 py-2 text-sm">Cancel</button>
      <button type="button" class="rounded-md bg-destructive px-3 py-2 text-sm text-destructive-foreground">Continue</button>
    </div>
  </div>
</div>
