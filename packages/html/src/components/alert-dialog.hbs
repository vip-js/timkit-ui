<div data-slot="alert-dialog" class="{{alertDialogOverlayVariants}}">
  <div class="{{alertDialogContentVariants}}">
    <h2 class="{{alertDialogTitleVariants}}">Are you absolutely sure?</h2>
    <p class="{{alertDialogDescriptionVariants}}">
      This action cannot be undone.
    </p>
    <div class="mt-4 flex justify-end gap-2">
      <button class="rounded-md border px-3 py-2 text-sm">Cancel</button>
      <button class="rounded-md bg-destructive px-3 py-2 text-sm text-destructive-foreground">Continue</button>
    </div>
  </div>
</div>
