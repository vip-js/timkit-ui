<div data-slot="select" class="{{selectItemVariants}}">
  <button id="select-trigger" data-slot="select-trigger" type="button" role="combobox" aria-haspopup="listbox" aria-expanded="false" aria-controls="select-list" class="{{selectItemVariants}}">
    <span data-slot="select-value" class="line-clamp-1">Select option</span>
  </button>
  <div
    id="select-list"
    data-slot="select-content"
    role="listbox" tabindex="0"
    aria-labelledby="select-trigger"
    hidden
    class="{{selectContentVariants}}"
  >
    <div data-slot="select-item" role="option" aria-selected="false" class="{{selectLabelVariants}}">
      Option one
    </div>
    <div data-slot="select-item" role="option" aria-selected="false" class="{{selectLabelVariants}}">
      Option two
    </div>
  </div>
</div>
