<div class="grid gap-2" role="radiogroup" aria-label="Radio group">
    <p role="status">Option 1 of 2</p>
    <div class="{{radioGroupIndicatorVariants}}">
        <button type="button" role="radio" aria-checked="true" tabindex="0" aria-labelledby="radio-default-label" data-state="checked" value="default"
            class="{{sheetCloseIconVariants}}">
            <span class="{{radioGroupIndicatorVariants}}">
                <svg aria-hidden="true" width="6" height="6" viewBox="0 0 6 6" fill="currentcolor" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="3" cy="3" r="3" />
                </svg>
            </span>
        </button>
        <label id="radio-default-label"
            class="{{labelVariants}}">Default</label>
    </div>
    <div class="{{radioGroupIndicatorVariants}}">
        <button type="button" role="radio" aria-checked="false" tabindex="-1" aria-labelledby="radio-other-label" data-state="unchecked" value="other"
            class="{{sheetCloseIconVariants}}"></button>
        <label id="radio-other-label"
            class="{{labelVariants}}">Other</label>
    </div>
</div>