<div data-slot="tabs" data-orientation="horizontal" class="w-full">
    <p role="status">Tab 1 of 2</p>
    <div data-slot="tabs-list" role="tablist" aria-label="Tabs" class="{{tabsListVariants}}">
        <button type="button" id="tabs-trigger-1" role="tab" aria-selected="true" tabindex="0" aria-controls="tabs-panel-1" data-slot="tabs-trigger" data-state="active" class="{{tabsTriggerVariants}}">Tab 1</button>
        <button type="button" id="tabs-trigger-2" role="tab" aria-selected="false" tabindex="-1" aria-controls="tabs-panel-2" data-slot="tabs-trigger" data-state="inactive" class="{{tabsTriggerVariants}}">Tab 2</button>
    </div>
    <div id="tabs-panel-1" role="tabpanel" tabindex="0" aria-labelledby="tabs-trigger-1" data-slot="tabs-content" data-state="active" class="{{tabsContentVariants}}">
        Content 1
    </div>
    <div id="tabs-panel-2" role="tabpanel" tabindex="-1" aria-labelledby="tabs-trigger-2" hidden data-slot="tabs-content" data-state="inactive" class="{{tabsContentVariants}}">
        Content 2
    </div>
</div>