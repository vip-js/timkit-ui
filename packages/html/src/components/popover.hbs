<div data-slot="popover" class="{{navigationMenuItemVariants}}">
  <button id="popover-trigger" data-slot="popover-trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="popover-content" class="{{switchRootVariants}}">
    Open popover
  </button>
  <div
    id="popover-content"
    role="dialog" tabindex="-1"
    aria-label="Popover"
    data-slot="popover-content"
    data-state="closed"
    hidden
    class="absolute z-50 mt-2 w-72 rounded-md border bg-popover p-4 text-popover-foreground shadow-md"
  >
    Popover content
  </div>
</div>
