<div data-slot="sheet-root" data-state="closed">
  <button
    id="sheet-trigger"
    data-slot="sheet-trigger"
    type="button"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="sheet-content"
    class="rounded-md border px-4 py-2 text-sm"
  >
    Open sheet
  </button>
  <div
    data-slot="sheet-overlay"
    data-state="closed"
    hidden
    class="fixed inset-0 z-40 bg-black/40"
  ></div>
  <aside
    id="sheet-content"
    role="dialog" tabindex="-1"
    aria-labelledby="sheet-title"
    aria-describedby="sheet-description"
    data-slot="sheet-content"
    data-state="closed"
    hidden
    class="fixed right-0 top-0 z-50 h-full w-80 border-l border-input bg-background p-4 shadow-lg"
  >
    <div class="space-y-3">
      <h2 id="sheet-title" class="{{sheetTitleVariants}}">Sheet Title</h2>
      <p id="sheet-description" class="{{sheetDescriptionVariants}}">Panel content goes here.</p>
      <button data-slot="sheet-close" type="button" class="rounded-md border px-3 py-2 text-sm">Close</button>
    </div>
  </aside>
</div>
