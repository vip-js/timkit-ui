<div role="status" aria-live="polite" data-slot="toast" data-state="open"
    class="{{toastVariants}}">
    <div class="grid gap-1">
        <div data-slot="toast-title" class="{{toastTitleVariants}}">Toast Title</div>
        <div data-slot="toast-description" class="{{toastDescriptionVariants}}">Toast message goes here.</div>
    </div>
    <button data-slot="toast-close"
        class="absolute top-1 right-1 rounded-md p-1 text-foreground/50 opacity-0 transition-opacity hover:text-foreground focus:opacity-100 focus:outline-none focus:ring-1 group-hover:opacity-100">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>
</div>
