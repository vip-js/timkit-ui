<label data-slot="switch-root" class="{{switchRootVariants}}">
    <button type="button" role="switch" data-slot="switch" data-state="unchecked" aria-checked="false" class="{{switchVariants}}">
        <span data-slot="switch-thumb" data-state="unchecked" class="{{switchThumbVariants}}"></span>
    </button>
    <input type="checkbox"
        style="border: 0px; clip: rect(0px, 0px, 0px, 0px); clip-path: inset(50%); height: 1px; margin: -1px; overflow: hidden; padding: 0px; position: absolute; width: 1px; white-space: nowrap; word-wrap: normal;" />
</label>
