<div data-slot="calendar" class="{{calendarGridVariants}}">
  <div class="{{calendarDayButtonVariants}}">
    <button type="button" class="rounded-sm px-2 py-1 hover:bg-accent">&lt;</button>
    <div class="{{calendarCaptionLabelVariants}}">March 2026</div>
    <button type="button" class="rounded-sm px-2 py-1 hover:bg-accent">&gt;</button>
  </div>
  <div class="grid grid-cols-7 gap-1 text-center text-xs text-muted-foreground">
    <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
  </div>
  <div class="mt-2 grid grid-cols-7 gap-1 text-center text-sm">
    <button class="h-8 rounded-sm hover:bg-accent">1</button>
    <button class="h-8 rounded-sm hover:bg-accent">2</button>
    <button class="h-8 rounded-sm bg-primary text-primary-foreground">3</button>
  </div>
</div>
