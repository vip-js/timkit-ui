<div class="relative w-full overflow-auto">
    <table data-slot="table" class="{{tableVariants}}">
        <thead data-slot="table-header" class="{{tableHeaderVariants}}">
            <tr data-slot="table-row" class="{{tableRowVariants}}">
                <th data-slot="table-head" class="{{tableHeadVariants}}">
                    Header
                </th>
            </tr>
        </thead>
        <tbody data-slot="table-body" class="{{tableBodyVariants}}">
            <tr data-slot="table-row" class="{{tableRowVariants}}">
                <td data-slot="table-cell" class="{{tableCellVariants}}">
                    Cell
                </td>
            </tr>
        </tbody>
    </table>
</div>