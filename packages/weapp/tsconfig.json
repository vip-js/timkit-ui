{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "miniprogram-api-typings"
    ],
    "paths": {
      "@timui/*": [
        "../*/src"
      ]
    },
    "composite": false
  },
  "include": [
    "src",
    "primitives",
    "../core/src",
    "../tokens/src"
  ]
}
