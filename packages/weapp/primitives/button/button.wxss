.tk-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  border-radius: var(--radius-md);
  font-size: var(--typography-md);
  font-weight: 600;
  line-height: 1;
  padding: var(--spacing-sm) var(--spacing-lg);
  color: var(--color-onPrimary);
  background-color: var(--color-primary);
  border: 1px solid transparent;
  transition: opacity 150ms linear;
}

.tk-button__label {
  white-space: nowrap;
}

.tk-button__spinner {
  width: 16px;
  height: 16px;
  border-radius: 999px;
  border: 2px solid rgba(255, 255, 255, 0.4);
  border-top-color: var(--color-onPrimary);
  animation: tk-spin 600ms linear infinite;
  margin-left: 4px;
}

@keyframes tk-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.tk-button.is-hover {
  opacity: 0.92;
}

.tk-button:active,
.tk-button.is-loading {
  opacity: 0.72;
}

.tk-button.is-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.tk-button.primary {
  background-color: var(--color-primary);
  color: var(--color-onPrimary);
}

.tk-button.secondary {
  background-color: var(--color-secondary);
  color: var(--color-onSecondary);
  border-color: var(--color-border);
}

.tk-button.ghost {
  background-color: transparent;
  color: var(--color-foreground);
  border-color: var(--color-border);
}

.tk-button.destructive {
  background-color: var(--color-destructive);
  color: var(--color-onDestructive);
}

.tk-button.size-sm {
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-sm);
  font-size: var(--typography-sm);
}

.tk-button.size-lg {
  padding: var(--spacing-lg) calc(var(--spacing-lg) * 1.3);
  border-radius: var(--radius-lg);
  font-size: var(--typography-lg);
}
