.tree {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tree-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 48rpx;
}

.tree-toggle {
  width: 28rpx;
  color: #6b7280;
}

.tree-toggle-empty {
  visibility: hidden;
}

.tree-label {
  flex: 1;
  font-size: 26rpx;
  color: #111827;
}
