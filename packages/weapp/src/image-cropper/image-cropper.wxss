.image-cropper {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-wrap {
  width: 100%;
  height: 320rpx;
  border: 1px solid #d1d5db;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9fafb;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.preview-empty {
  color: #6b7280;
  font-size: 26rpx;
}

.sliders {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.slider-label {
  color: #111827;
  font-size: 24rpx;
}

.apply-button {
  margin-top: 8rpx;
}
