.navigation-menu {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.navigation-menu-item {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #111827;
  font-size: 26rpx;
}

.is-active {
  background: #111827;
  color: #ffffff;
}

.is-disabled {
  opacity: 0.5;
}
