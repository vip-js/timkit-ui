<view class="{{className}}" data-disabled="{{disabled}}">
  <!-- Tags List -->
  <view class="tags-list">
    <view 
      wx:for="{{api.value}}" 
      wx:key="index"
      class="tag-item"
      data-index="{{index}}"
    >
      <text class="tag-text">{{item}}</text>
      <view 
        class="tag-delete" 
        data-index="{{index}}"
        bindtap="onDeleteTag"
      >×</view>
    </view>

    <!-- Input -->
    <input 
      wx:if="{{!api.isAtMax}}"
      class="tags-input"
      type="text"
      value="{{inputValue}}"
      placeholder="{{placeholder}}"
      disabled="{{disabled || readOnly}}"
      bindinput="onInput"
      bindconfirm="onConfirm"
    />
  </view>

  <!-- Max Indicator -->
  <text wx:if="{{max < 999}}" class="tags-count">
    {{api.value.length}} / {{max}}
  </text>
</view>
