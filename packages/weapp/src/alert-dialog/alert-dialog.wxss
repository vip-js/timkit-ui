.alert-dialog-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
}

.alert-dialog-content {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.18);
  z-index: 1001;
  overflow: hidden;
}

.alert-dialog-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 12rpx;
}

.alert-dialog-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.alert-dialog-close {
  font-size: 36rpx;
  line-height: 1;
  color: #6b7280;
}

.alert-dialog-body {
  padding: 0 28rpx 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #374151;
}

.alert-dialog-footer {
  padding: 0 28rpx 28rpx;
}

.alert-dialog-actions {
  display: flex;
  gap: 16rpx;
}

.alert-dialog-cancel-btn,
.alert-dialog-confirm-btn {
  flex: 1;
  text-align: center;
  border-radius: 12rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
}

.alert-dialog-cancel-btn {
  background: #f3f4f6;
  color: #374151;
}

.alert-dialog-confirm-btn {
  background: #111827;
  color: #ffffff;
}
