<label 
    id="{{api.rootProps.id}}"
    class="flex items-center space-x-2 {{className}} opacity-{{api.disabled ? 50 : 100}}"
    style="min-height: 88rpx;"
    data-state="{{api.checked ? 'checked' : 'unchecked'}}"
    data-disabled="{{api.disabled}}"
    bindtap="onTap"
>
    <!-- Visual Checkbox -->
    <view class="peer h-5 w-5 shrink-0 rounded-sm border border-primary shadow focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=checked]:text-primary-foreground data-[state=indeterminate]:bg-primary data-[state=indeterminate]:text-primary-foreground"
      data-state="{{api.checked ? 'checked' : api.checked === 'indeterminate' ? 'indeterminate' : 'unchecked'}}">
        <block wx:if="{{api.checked === true}}">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </block>
        <block wx:if="{{api.checked === 'indeterminate'}}">
             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </block>
    </view>
    <!-- Label Slot -->
    <slot />
    <!-- Hidden Input for Form Submission -->
    <input type="text" class="hidden" name="{{name}}" value="{{api.checked}}" style="display: none;" />
</label>
