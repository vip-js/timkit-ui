<root-portal wx:if="{{open}}">
  <view class="{{overlayClass}}" data-state="open" bindtap="close" catchtouchmove="noop"></view>
  <view class="{{contentClass}}" data-state="open" catchtouchmove="noop">
    <slot></slot>
    <view class="absolute right-4 top-4 rounded-sm opacity-70 transition-opacity hover-opacity-100 focus-outline-none disabled-pointer-events-none" bindtap="close">
      <text class="text-xs">✕</text>
    </view>
  </view>
</root-portal>
