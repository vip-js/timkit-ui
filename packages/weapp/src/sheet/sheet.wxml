<root-portal wx:if="{{api.open}}">
  <!-- Overlay -->
  <view 
    class="{{overlayClass}}" 
    data-state="{{api.open ? 'open' : 'closed'}}" 
    bindtap="onBackdropTap" 
    catchtouchmove="noop"
  ></view>

  <!-- Sheet Content -->
  <view 
    class="{{contentClass}}" 
    data-state="{{api.open ? 'open' : 'closed'}}"
    data-side="{{side}}"
    id="{{api.contentProps.id}}"
    role="dialog"
    aria-modal="true"
    aria-label="{{api.contentProps['aria-label']}}"
  >
    <slot></slot>
    
    <!-- Close Button -->
    <view 
      class="{{closeClass}}" 
      data-state="{{api.open ? 'open' : 'closed'}}"
      bindtap="onCloseTap"
    >
      <text>✕</text>
    </view>
  </view>
</root-portal>
