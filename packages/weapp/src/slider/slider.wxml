<view class="{{rootClass}}">
  <slider
    min="{{min}}"
    max="{{max}}"
    value="{{value}}"
    step="{{step}}"
    disabled="{{disabled}}"
    show-value="{{showValue}}"
    activeColor="{{activeColor}}"
    backgroundColor="{{backgroundColor}}"
    block-size="{{blockSize}}"
    block-color="{{blockColor}}"
    name="{{name}}"
    bindchange="onSliderChange"
    bindchanging="onSliderChanging"
  />
</view>
