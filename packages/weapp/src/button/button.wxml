<view>
  <view wx:if="{{loadStatus}}" role="status">{{loadStatus}}</view>
<button
  wx:if="{{accessibleName}}"
  class="{{className}}"
  disabled="{{disabled || loading}}"
  loading="{{loading}}"
  aria-busy="{{loading ? 'true' : 'false'}}"
  aria-label="{{accessibleName}}"
  open-type="{{openType}}"
  form-type="{{formType}}"
  hover-class="{{hoverClass}}"
  hover-stop-propagation="{{hoverStopPropagation}}"
  hover-start-time="{{hoverStartTime}}"
  hover-stay-time="{{hoverStayTime}}"
  bindtap="onTap"
  bindgetphonenumber="onGetPhoneNumber"
  bindgetuserinfo="onGetUserInfo"
  bindopensetting="onOpenSetting"
  binderror="onError"
  bindcontact="onContact"
  data-disabled="{{disabled}}"
  data-loading="{{loading}}"
>
  <view wx:if="{{loading}}" class="button-loading-icon" aria-hidden="true">⏳</view>
  <slot></slot>
</button>
<button
  wx:else
  class="{{className}}"
  disabled="{{disabled || loading}}"
  loading="{{loading}}"
  aria-busy="{{loading ? 'true' : 'false'}}"
  open-type="{{openType}}"
  form-type="{{formType}}"
  hover-class="{{hoverClass}}"
  hover-stop-propagation="{{hoverStopPropagation}}"
  hover-start-time="{{hoverStartTime}}"
  hover-stay-time="{{hoverStayTime}}"
  bindtap="onTap"
  bindgetphonenumber="onGetPhoneNumber"
  bindgetuserinfo="onGetUserInfo"
  bindopensetting="onOpenSetting"
  binderror="onError"
  bindcontact="onContact"
  data-disabled="{{disabled}}"
  data-loading="{{loading}}"
>
  <view wx:if="{{loading}}" class="button-loading-icon" aria-hidden="true">⏳</view>
  <slot></slot>
</button>
</view>
