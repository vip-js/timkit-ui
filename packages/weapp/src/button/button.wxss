/* Additional resets for Weapp Button if not covered by tailwind utilities */
button {
  margin: 0;
  padding: 0;
  border: none;
  background-color: transparent;
  line-height: normal; /* Check shared config 'leading-normal' matches */
  border-radius: 0;
}

