/* packages/weapp/src/input/input.wxss */
.tk-input {
  display: flex;
  height: 36px; /* h-9 */
  width: 100%;
  border-radius: 6px; /* rounded-md */
  border: 1px solid var(--color-input); /* border border-input */
  background-color: transparent; /* bg-transparent */
  padding: 0 12px; /* px-3 */
  font-size: 14px; /* text-sm */
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05); /* shadow-sm */
  transition: all 0.2s;
  box-sizing: border-box;
}

.tk-input-placeholder {
  color: var(--color-muted-foreground);
  opacity: 0.7;
}

.tk-input:disabled {
  opacity: 0.5;
  pointer-events: none;
}
