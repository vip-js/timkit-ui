<view>
<input
  wx:if="{{ariaLabel && described}}"
  id="{{id}}"
  class="{{className}}"
  aria-invalid="{{invalid === true || invalid === 'true' ? 'true' : 'false'}}"
  aria-describedby="{{described}}"
  type="{{nativeType}}"
  password="{{masked}}"
  value="{{current}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  aria-readonly="{{readOnly ? 'true' : 'false'}}"
  aria-required="{{required ? 'true' : 'false'}}"
  aria-label="{{ariaLabel}}"
  maxlength="{{maxlength}}"
  focus="{{focus || returnFocus}}"
  confirm-type="{{confirmType}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
<input
  wx:elif="{{ariaLabel}}"
  id="{{id}}"
  class="{{className}}"
  aria-invalid="{{invalid === true || invalid === 'true' ? 'true' : 'false'}}"
  type="{{nativeType}}"
  password="{{masked}}"
  value="{{current}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  aria-readonly="{{readOnly ? 'true' : 'false'}}"
  aria-required="{{required ? 'true' : 'false'}}"
  aria-label="{{ariaLabel}}"
  maxlength="{{maxlength}}"
  focus="{{focus || returnFocus}}"
  confirm-type="{{confirmType}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
<input
  wx:elif="{{described}}"
  id="{{id}}"
  class="{{className}}"
  aria-invalid="{{invalid === true || invalid === 'true' ? 'true' : 'false'}}"
  aria-describedby="{{described}}"
  type="{{nativeType}}"
  password="{{masked}}"
  value="{{current}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  aria-readonly="{{readOnly ? 'true' : 'false'}}"
  aria-required="{{required ? 'true' : 'false'}}"
  maxlength="{{maxlength}}"
  focus="{{focus || returnFocus}}"
  confirm-type="{{confirmType}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
<input
  wx:else
  id="{{id}}"
  class="{{className}}"
  aria-invalid="{{invalid === true || invalid === 'true' ? 'true' : 'false'}}"
  type="{{nativeType}}"
  password="{{masked}}"
  value="{{current}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  aria-readonly="{{readOnly ? 'true' : 'false'}}"
  aria-required="{{required ? 'true' : 'false'}}"
  maxlength="{{maxlength}}"
  focus="{{focus || returnFocus}}"
  confirm-type="{{confirmType}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
<view
  wx:if="{{current && !disabled && !readOnly && type !== 'file'}}"
  role="button"
  aria-label="Clear"
  tabindex="0"
  bindtap="onClear"
  bindkeydown="onClearKey"
>Clear</view>
<view
  wx:if="{{type === 'password' && !disabled}}"
  role="button"
  aria-label="{{revealed ? 'Hide password' : 'Show password'}}"
  tabindex="0"
  bindtap="onReveal"
  bindkeydown="onRevealKey"
>{{revealed ? 'Hide password' : 'Show password'}}</view>
<view wx:if="{{revealStatus}}" role="status">{{revealStatus}}</view>
<view wx:if="{{maxlength >= 0 && type !== 'file'}}" id="{{id}}-count" role="status">{{count}} of {{maxlength}}</view>
</view>
