<view wx:if="{{open}}" class="{{className}}" data-slot="notification" data-state="open" data-variant="{{variant}}" role="status">
  <slot></slot>
  <view wx:if="{{closable}}" data-slot="notification-close" role="button" tabindex="0" aria-label="Close" bindtap="onCloseTap" bindkeydown="onCloseKey"><text aria-hidden="true">×</text></view>
</view>
