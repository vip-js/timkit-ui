<view>
<textarea
  wx:if="{{ariaLabel && described}}"
  id="{{id}}"
  class="{{className}}"
  aria-invalid="{{invalid === true || invalid === 'true' ? 'true' : 'false'}}"
  aria-describedby="{{described}}"
  value="{{current}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  aria-readonly="{{readOnly ? 'true' : 'false'}}"
  aria-required="{{required ? 'true' : 'false'}}"
  aria-label="{{ariaLabel}}"
  maxlength="{{maxlength}}"
  auto-height="{{autoHeight}}"
  focus="{{focus || returnFocus}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
<textarea
  wx:elif="{{ariaLabel}}"
  id="{{id}}"
  class="{{className}}"
  aria-invalid="{{invalid === true || invalid === 'true' ? 'true' : 'false'}}"
  value="{{current}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  aria-readonly="{{readOnly ? 'true' : 'false'}}"
  aria-required="{{required ? 'true' : 'false'}}"
  aria-label="{{ariaLabel}}"
  maxlength="{{maxlength}}"
  auto-height="{{autoHeight}}"
  focus="{{focus || returnFocus}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
<textarea
  wx:elif="{{described}}"
  id="{{id}}"
  class="{{className}}"
  aria-invalid="{{invalid === true || invalid === 'true' ? 'true' : 'false'}}"
  aria-describedby="{{described}}"
  value="{{current}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  aria-readonly="{{readOnly ? 'true' : 'false'}}"
  aria-required="{{required ? 'true' : 'false'}}"
  maxlength="{{maxlength}}"
  auto-height="{{autoHeight}}"
  focus="{{focus || returnFocus}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
<textarea
  wx:else
  id="{{id}}"
  class="{{className}}"
  aria-invalid="{{invalid === true || invalid === 'true' ? 'true' : 'false'}}"
  value="{{current}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  aria-readonly="{{readOnly ? 'true' : 'false'}}"
  aria-required="{{required ? 'true' : 'false'}}"
  maxlength="{{maxlength}}"
  auto-height="{{autoHeight}}"
  focus="{{focus || returnFocus}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
<view
  wx:if="{{current && !disabled && !readOnly}}"
  role="button"
  aria-label="Clear"
  tabindex="0"
  bindtap="onClear"
  bindkeydown="onClearKey"
>Clear</view>
<view wx:if="{{maxlength >= 0}}" id="{{id}}-count" role="status">{{count}} of {{maxlength}}</view>
</view>
