<textarea 
  class="{{className}}"
  value="{{value}}"
  placeholder="{{placeholder}}"
  disabled="{{disabled}}"
  maxlength="{{maxlength}}"
  auto-height="{{autoHeight}}"
  focus="{{focus}}"
  adjust-position="{{true}}"
  cursor-spacing="{{16}}"
  bindinput="onInput"
  bindfocus="onFocus"
  bindblur="onBlur"
  bindconfirm="onConfirm"
/>
