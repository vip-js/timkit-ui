.resizable {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.panels {
  display: flex;
  width: 100%;
  height: 200rpx;
  overflow: hidden;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
}

.panel {
  height: 100%;
  overflow: auto;
  padding: 12rpx;
}

.panel-left {
  background: #f9fafb;
}

.panel-right {
  background: #ffffff;
}
