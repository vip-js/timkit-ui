<!-- Picker ActionSheet -->
<root-portal wx:if="{{api.open}}">
    <!-- Backdrop -->
    <view class="fixed inset-0 z-50 bg-black/80 animate-in fade-in-0" bindtap="onBackdropTap"></view>
    
    <!-- Content (Slide up from bottom) -->
    <view class="fixed inset-x-0 bottom-0 z-50 rounded-t-xl bg-popover p-4 shadow-lg animate-in slide-in-from-bottom border-t border-border">
        <!-- Header -->
        <view class="flex items-center justify-between mb-4">
             <text class="text-lg font-semibold">{{label || 'Choose an item'}}</text>
             <view class="p-2 -mr-2" role="button" tabindex="0" aria-label="Close" bindtap="onBackdropTap" bindkeydown="onCloseKey">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
             </view>
        </view>
        
        <input
            wx:if="{{highlight >= 0 && ariaLabel && labelledBy}}"
            value="{{query}}"
            placeholder="{{placeholder}}"
            aria-labelledby="{{labelledBy}}"
            aria-label="{{ariaLabel}}"
            disabled="{{disabled}}"
            aria-readonly="{{readOnly ? 'true' : 'false'}}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="{{id}}-listbox"
            aria-activedescendant="{{id}}-option-{{highlight}}"
            bindinput="onQuery"
            bindkeydown="onKey"
        />
        <input
            wx:elif="{{ariaLabel && labelledBy}}"
            value="{{query}}"
            placeholder="{{placeholder}}"
            aria-labelledby="{{labelledBy}}"
            aria-label="{{ariaLabel}}"
            disabled="{{disabled}}"
            aria-readonly="{{readOnly ? 'true' : 'false'}}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="{{id}}-listbox"
            bindinput="onQuery"
            bindkeydown="onKey"
        />
        <input
            wx:elif="{{highlight >= 0 && ariaLabel}}"
            value="{{query}}"
            placeholder="{{placeholder}}"
            aria-label="{{ariaLabel}}"
            disabled="{{disabled}}"
            aria-readonly="{{readOnly ? 'true' : 'false'}}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="{{id}}-listbox"
            aria-activedescendant="{{id}}-option-{{highlight}}"
            bindinput="onQuery"
            bindkeydown="onKey"
        />
        <input
            wx:elif="{{ariaLabel}}"
            value="{{query}}"
            placeholder="{{placeholder}}"
            aria-label="{{ariaLabel}}"
            disabled="{{disabled}}"
            aria-readonly="{{readOnly ? 'true' : 'false'}}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="{{id}}-listbox"
            bindinput="onQuery"
            bindkeydown="onKey"
        />
        <input
            wx:elif="{{highlight >= 0 && labelledBy}}"
            value="{{query}}"
            placeholder="{{placeholder}}"
            aria-labelledby="{{labelledBy}}"
            disabled="{{disabled}}"
            aria-readonly="{{readOnly ? 'true' : 'false'}}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="{{id}}-listbox"
            aria-activedescendant="{{id}}-option-{{highlight}}"
            bindinput="onQuery"
            bindkeydown="onKey"
        />
        <input
            wx:elif="{{labelledBy}}"
            value="{{query}}"
            placeholder="{{placeholder}}"
            aria-labelledby="{{labelledBy}}"
            disabled="{{disabled}}"
            aria-readonly="{{readOnly ? 'true' : 'false'}}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="{{id}}-listbox"
            bindinput="onQuery"
            bindkeydown="onKey"
        />
        <input
            wx:elif="{{highlight >= 0}}"
            value="{{query}}"
            placeholder="{{placeholder}}"
            aria-label="{{label || placeholder}}"
            disabled="{{disabled}}"
            aria-readonly="{{readOnly ? 'true' : 'false'}}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="{{id}}-listbox"
            aria-activedescendant="{{id}}-option-{{highlight}}"
            bindinput="onQuery"
            bindkeydown="onKey"
        />
        <input
            wx:else
            value="{{query}}"
            placeholder="{{placeholder}}"
            aria-label="{{label || placeholder}}"
            disabled="{{disabled}}"
            aria-readonly="{{readOnly ? 'true' : 'false'}}"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="true"
            aria-controls="{{id}}-listbox"
            bindinput="onQuery"
            bindkeydown="onKey"
        />
        <view wx:if="{{empty}}" role="status">{{emptyLabel}}</view>
        <!-- List -->
        <scroll-view scroll-y class="max-h-[60vh]" id="{{id}}-listbox" role="listbox" aria-labelledby="{{id}}-trigger" tabindex="-1">
            <view class="flex flex-col space-y-1">
                <block wx:for="{{visibleItems}}" wx:key="value">
                    <view 
                        id="{{id}}-option-{{index}}"
                        class="flex cursor-default select-none items-center rounded-sm px-2 py-3 text-sm outline-none active:bg-accent active:text-accent-foreground data-[selected]:bg-accent data-[selected]:text-accent-foreground"
                        role="option"
                        tabindex="-1"
                        data-state="{{selected.includes(item.value) ? 'checked' : 'unchecked'}}"
                        data-selected="{{selected.includes(item.value) ? '' : undefined}}"
                        aria-selected="{{selected.includes(item.value) ? 'true' : 'false'}}"
                        data-highlighted="{{highlighted === index ? 'true' : 'false'}}"
                        aria-disabled="{{item.disabled ? 'true' : 'false'}}"
                        mark:value="{{item.value}}"
                        bindtap="onItemTap"
                        bindkeydown="onItemKey"
                    >
                        <!-- Check icon -->
                         <view class="mr-2 flex h-4 w-4 items-center justify-center opacity-{{selected.includes(item.value) ? 100 : 0}}">
                             <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                         </view>
                        
                        <text class="flex-1">{{item.label}}</text>
                    </view>
                </block>
            </view>
        </scroll-view>
    </view>
</root-portal>
