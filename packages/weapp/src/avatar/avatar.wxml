<view class="{{className}} avatar avatar-{{size}} avatar-{{shape}}" data-slot="avatar" data-status="{{status}}">
  <view wx:if="{{imageStatus}}" role="status">{{imageStatus}}</view>
  <image
    wx:if="{{src}}"
    class="avatar-image"
    src="{{src}}"
    alt="{{alt || 'Avatar'}}"
    aria-label="{{alt || 'Avatar'}}"
    mode="aspectFill"
    hidden="{{status !== 'loaded'}}"
    bindload="onImageLoad"
    binderror="onImageError"
  />
  <view
    wx:if="{{status !== 'loaded'}}"
    class="avatar-fallback"
    data-slot="avatar-fallback"
    aria-label="{{alt || fallback || 'Avatar'}}"
  >
    {{fallback}}
    <slot></slot>
  </view>
</view>
