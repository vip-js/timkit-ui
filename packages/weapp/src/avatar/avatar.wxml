<view class="{{className}} avatar avatar-{{size}} avatar-{{shape}}">
  <image 
    wx:if="{{src}}"
    class="avatar-image"
    src="{{src}}"
    mode="aspectFill"
    bindload="onImageLoad"
    binderror="onImageError"
  />
  <view wx:elif="{{fallback}}" class="avatar-fallback">
    {{fallback}}
  </view>
  <slot wx:else></slot>
</view>
