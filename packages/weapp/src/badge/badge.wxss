/* packages/weapp/src/badge/badge.wxss */
.tk-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999px; /* rounded-full */
  border: 1px solid transparent; /* border */
  padding: 0 6px; /* px-1.5 */
  font-size: 12px; /* text-xs */
  font-weight: 500; /* font-medium */
  white-space: nowrap;
  line-height: normal;
}

/* Variants */
.tk-badge-default {
  background-color: var(--color-primary);
  color: var(--color-primary-foreground);
  border-color: transparent;
}

.tk-badge-secondary {
  background-color: var(--color-secondary);
  color: var(--color-secondary-foreground);
  border-color: transparent;
}

.tk-badge-destructive {
  background-color: var(--color-destructive);
  color: #ffffff;
  border-color: transparent;
}

.tk-badge-outline {
  color: var(--color-foreground);
  border-color: var(--color-border); /* Usually outline variant uses border color or foreground? Web says 'text-foreground'. Tailwind 'border' class uses border color. */
}
