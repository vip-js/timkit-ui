{
  "name": "@timui/weapp",
  "version": "0.0.1",
  "private": false,
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "node --import tsx build.ts",
    "release": "pnpm run build && pnpm publish --access public --no-git-checks",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern dist",
    "generate:utils": "tsx ../../scripts/build-weapp-utilities.ts"
  },
  "miniprogram": "dist",
  "dependencies": {
    "@zag-js/core": "^1.32.0",
    "@timui/core": "workspace:*",
    "@timui/tokens": "workspace:*",
    "clsx": "^2.1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.27.1",
    "glob": "^13.0.0",
    "miniprogram-api-typings": "^3.12.2",
    "typescript": "^5.8.2"
  }
}
