{
  "name": "@timui/vue",
  "version": "0.0.1",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.mjs",
      "require": "./dist/components/*.js"
    },
    "./components/ui/breadcrumb-*": null,
    "./components/ui/command-*": null,
    "./components/ui/tags-input-*": null,
    "./components/ui/toast-*": null,
    "./components/ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.mjs",
      "require": "./dist/components/ui/*.js"
    },
    "./ui": {
      "types": "./dist/components/ui/index.d.ts",
      "import": "./dist/components/ui/index.mjs",
      "require": "./dist/components/ui/index.js"
    },
    "./ui/breadcrumb-*": null,
    "./ui/command-*": null,
    "./ui/tags-input-*": null,
    "./ui/toast-*": null,
    "./ui/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.mjs",
      "require": "./dist/components/ui/*.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.mjs",
      "require": "./dist/manifest.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.mjs",
      "require": "./dist/hooks/*.js"
    },
    "./tailwind-preset": {
      "types": "./tailwind-preset.ts",
      "import": "./tailwind-preset.ts",
      "require": "./tailwind-preset.ts"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "vue-tsc --declaration --emitDeclarationOnly --outDir dist && tsup",
    "postbuild": "node fix-ext.js && find dist -name '*.vue' -type f -delete",
    "release": "pnpm run build && pnpm publish --access public --no-git-checks",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern dist",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.7.0",
    "lucide-vue-next": "^0.555.0",
    "radix-vue": "^1.9.7",
    "vue": "^3.0.0",
    "vue-sonner": "^1.3.1"
  },
  "peerDependenciesMeta": {
    "@internationalized/date": {
      "optional": true
    },
    "lucide-vue-next": {
      "optional": true
    },
    "radix-vue": {
      "optional": true
    },
    "vue-sonner": {
      "optional": true
    }
  },
  "dependencies": {
    "@timui/core": "workspace:*",
    "@timui/tokens": "workspace:*",
    "@zag-js/core": "^1.32.0",
    "@zag-js/date-picker": "^1.32.0",
    "@zag-js/number-input": "^1.32.0",
    "@zag-js/pagination": "^1.32.0",
    "@zag-js/popper": "^1.32.0",
    "@zag-js/presence": "^1.32.0",
    "@zag-js/vue": "^1.32.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "esbuild-plugin-vue-next": "^0.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2",
    "unplugin-vue": "^7.1.0",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-tsc": "^2.2.12"
  }
}
