{
  "name": "@timui/vue",
  "version": "0.0.1",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./components/*": {
      "import": "./src/components/*",
      "require": "./src/components/*"
    },
    "./hooks/*": {
      "import": "./src/hooks/*",
      "require": "./src/hooks/*"
    },
    "./components-backup/*": {
      "import": "./src/components-backup/*",
      "require": "./src/components-backup/*"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "vue-tsc --declaration --emitDeclarationOnly --outDir dist && tsup",
    "release": "pnpm run build && pnpm publish --access public --no-git-checks",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern dist",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.7.0",
    "@timui/core": "workspace:*",
    "@timui/tokens": "workspace:*",
    "@zag-js/core": "^1.32.0",
    "@zag-js/date-picker": "^1.32.0",
    "@zag-js/number-input": "^1.32.0",
    "@zag-js/pagination": "^1.32.0",
    "@zag-js/popper": "^1.32.0",
    "@zag-js/presence": "^1.32.0",
    "@zag-js/vue": "^1.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.555.0",
    "radix-vue": "^1.9.7",
    "tailwind-merge": "^3.1.0",
    "vue-sonner": "^1.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "esbuild-plugin-vue-next": "^0.1.4",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2",
    "unplugin-vue": "^7.1.0",
    "vite": "^7.2.6",
    "vue": "^3.5.25",
    "vue-tsc": "^2.2.12"
  }
}
