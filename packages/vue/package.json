{
    "name": "@timkit/vue",
    "version": "0.0.1",
    "private": true,
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "vue-tsc --declaration --emitDeclarationOnly --outDir dist && tsup",
        "lint": "eslint .",
        "typecheck": "vue-tsc --noEmit"
    },
    "peerDependencies": {
        "vue": "^3.0.0"
    },
    "dependencies": {
        "@timkit/core": "workspace:*",
        "@timkit/shared": "workspace:*",
        "@timkit/tokens": "workspace:*",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^0.555.0",
        "radix-vue": "^1.9.17",
        "tailwind-merge": "^3.1.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.2",
        "esbuild-plugin-vue-next": "^0.1.4",
        "tsup": "^8.0.0",
        "typescript": "^5.8.2",
        "vite": "^7.2.6",
        "vue": "^3.5.25",
        "vue-tsc": "^2.2.12"
    }
}