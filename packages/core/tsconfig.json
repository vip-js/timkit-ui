{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@timui/tokens/*": ["../tokens/dist/*"],
      "@timui/*": ["../*/src"]
    },
    "declaration": true,
    "outDir": "./dist",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "src",
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["src"]
}
