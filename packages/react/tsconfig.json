{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./packages/react/src/*"
      ],
      "@timui/react": [
        "./packages/react/src"
      ],
      "@timui/react/*": [
        "./packages/react/src/*"
      ],
      "@timui/*": [
        "./packages/*/src"
      ]
    },
    "composite": false,
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*",
    "../core/src",
    "../tokens/src"
  ]
}
