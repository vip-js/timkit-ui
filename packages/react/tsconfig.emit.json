{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declarationDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": [
    "src/**/*",
    "../core/src",
    "../tokens/src"
  ],
  "exclude": [
    "src/blocks",
    "dist",
    "node_modules"
  ]
}
