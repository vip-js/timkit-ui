<view 
  class="{{className}} flex items-center justify-center"
  data-slot="checkbox"
  data-state="{{indeterminate ? 'indeterminate' : (checked ? 'checked' : 'unchecked')}}"
  data-disabled="{{disabled}}"
  bindtap="handleTap"
>
  <view wx:if="{{checked || indeterminate}}" data-slot="checkbox-indicator" class="grid place-content-center text-current">
    <view wx:if="{{indeterminate}}" class="w-2 h-0.5 bg-current rounded-full"></view>
    <image class="w-3 h-3" src="data:image/svg+xml;base64," />
  </view>
</view>
