<view class="timui-html-demo space-y-4 p-4">
<view class="*:not-first:mt-3">
    <text data-slot="label">Slider with input</text>
    <view class="flex items-center gap-4">
      <input type="range" data-slot="slider"
       
       
        aria-label="Slider with input">
      <input data-slot="input" class="h-8 w-12 px-2 py-1 flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm"
       
        type="text"
        inputMode="decimal"
       ="(next) => handleInputChange(next, 0)"
       
       
        aria-label="Enter value" />
    </view>
  </view>
</view>
