<view class="timui-html-demo space-y-4 p-4">
<view class="space-y-3">
    <view class="flex items-center justify-between gap-2">
      <text data-slot="label">Temperature</text>
      <view class="flex items-center gap-1">
        <view data-slot="tooltip-provider" delayDuration="0">
          <text data-slot="tooltip">
            <button type="button" data-slot="tooltip-trigger">
              <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
                size="icon"
                variant="ghost"
                aria-label="Reset">
                <text aria-hidden="true" size="16" aria-hidden="true">
              </button>
            </button>
            <text role="tooltip" data-slot="tooltip-content">Reset to default</text>
          </text>
        
        <input data-slot="input" class="h-7 w-12 px-2 py-0 flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm"
         
          type="text"
          inputMode="decimal"
         ="(next) => handleInputChange(next, 0)"
         
         
          aria-label="Enter value" />
      </view>
    </view>
    <view class="flex items-center gap-4">
      <input type="range" data-slot="slider"
       
        step="0.01"
        aria-label="Temperature">
    </view>
  </view>
</view>
