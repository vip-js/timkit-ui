<view>
  <view class="space-y-3"><view class="flex items-center justify-between gap-2"><label class="leading-6">Rate your experience</label><text class="text-sm font-medium">{{ labels[value[0] - 1] }}</text></view><view class="flex items-center gap-2"><text class="text-2xl">😡</text><slider value="{{value}}" bindchange="setValue" min="{{1}}" max="{{5}}" aria-label="Rate your experience" /><text class="text-2xl">😍</text></view></view>
</view>