<view>
  <view class="*:not-first:mt-3"><label>Rate your experience</label><view class="flex items-center gap-2"><slider value="{{value}}" bindchange="setValue" min="{{1}}" max="{{5}}" showtooltip tooltipcontent="{{(value) => labels[value - 1]}}" aria-label="Rate your experience" /><text class="text-2xl">{{ emojis[value[0] - 1] }}</text></view></view>
</view>