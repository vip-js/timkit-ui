<view class="timui-html-demo space-y-4 p-4">
<view data-slot="toast-provider" swipeDirection="left">
    <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">Custom toast</button>
    <view data-slot="toast">
      <view class="flex w-full justify-between gap-3">
        <text aria-hidden="true" size="16" aria-hidden="true">
        <view class="flex grow flex-col gap-3">
          <view class="space-y-1">
            <view data-slot="toast-title">Your request was completed!
            <view data-slot="toast-description">It demonstrates that the task or request has been processed.
          </view>
          <view>
            <view data-slot="toast-action" altText="Undo changes">
              <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" size="sm">Undo changes</button>
            
          </view>
        </view>
        <view data-slot="toast-close">
          <button type="button" data-slot="button" class="group -my-1.5 -me-2 size-8 shrink-0 p-0 hover:bg-transparent inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
            variant="ghost"
           
            aria-label="Close notification">
            <text aria-hidden="true" size="16"
             
              aria-hidden="true">
          </button>
        
      </view>
      <view class="contents" aria-hidden="true">
        <view
          class="pointer-events-none absolute bottom-0 left-0 h-1 w-full bg-emerald-500">
      </view>
    
    <text aria-hidden="true">
</view>
