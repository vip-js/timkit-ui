// To make the notification fixed, add classes like "fixed bottom-4 right-4" to the container element.
    <view class="bg-background z-50 max-w-[400px] rounded-md border p-4 shadow-lg">
      <view class="flex gap-3">
        <view
          class="flex size-9 shrink-0 items-center justify-center rounded-full border"
          aria-hidden="true"
        >
           <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60"><circle cx="12" cy="12" r="9" /></svg>
        </view>
        <view class="flex grow flex-col gap-3">
          <view class="space-y-1">
            <p class="text-sm font-medium">Version 1.4 is now available!</p>
            <p class="text-muted-foreground text-sm">
              This update contains several bug fixes and performance improvements.
            </p>
          </view>
          <view class="flex gap-2">
            <button size="sm">Install</button>
            <button size="sm" variant="link">
              Later
            </button>
          </view>
        </view>
        <button
          variant="ghost"
          class="group -my-1.5 -me-2 size-8 shrink-0 p-0 hover:bg-transparent"
          aria-label="Close notification"
        >
           <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-60 transition-opacity group-hover:opacity-100"><circle cx="12" cy="12" r="9" /></svg>
        </button>
      </view>
    </view>