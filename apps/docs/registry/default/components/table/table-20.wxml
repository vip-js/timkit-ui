<view class="timui-html-demo space-y-4 p-4">
<view class="space-y-4">
    <view class="flex flex-wrap items-center justify-between gap-3">
      <view class="flex items-center gap-3">
        <view class="relative">
          <input data-slot="input" class="peer min-w-60 ps-9 flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm"
           
            placeholder="Filter by name or email..."
            type="text"
            aria-label="Filter by name or email">
          <view class="text-muted-foreground/80 pointer-events-none absolute inset-y-0 start-0 flex items-center justify-center ps-3">
            <text aria-hidden="true" size="16" aria-hidden="true">
          </view>
          <button
           
            class="text-muted-foreground/80 hover:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 absolute inset-y-0 end-0 flex h-full w-9 items-center justify-center rounded-e-md transition-[color,box-shadow] outline-none focus:z-10 focus-visible:ring-[3px]"
            aria-label="Clear filter">
            <text aria-hidden="true" size="16" aria-hidden="true">
          </button>
        </view>

        <view data-slot="popover">
          <button type="button" data-slot="popover-trigger">
            <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">
              <text aria-hidden="true" size="16" aria-hidden="true">
              Status
              <text
               
                class="bg-background text-muted-foreground/70 -me-1 inline-flex h-5 max-h-full items-center rounded border px-1 text-[0.625rem] font-medium">
                
              </text>
            </button>
          </button>
          <view data-slot="popover-content" align="start">
            <view class="space-y-3">
              <view class="text-muted-foreground text-xs font-medium">Filters</view>
              <view class="space-y-3">
                <view class="flex items-center gap-2">
                  <input type="checkbox" data-slot="checkbox" id="status-Example">
                  <text data-slot="label" for="status-Example"></text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view data-slot="popover">
          <button type="button" data-slot="popover-trigger">
            <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">
              <text aria-hidden="true" size="16" aria-hidden="true">
              View
            </button>
          </button>
          <view data-slot="popover-content" align="start">
            <view class="space-y-3">
              <view class="text-muted-foreground text-xs font-medium">Toggle columns</view>
              <view class="space-y-3">
                <view class="flex items-center gap-2">
                  <input type="checkbox" data-slot="checkbox" id="column-Example">
                  <text data-slot="label" for="column-Example"></text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="flex items-center gap-3">
        <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"="selectedCount> 0" variant="outline">
          <text aria-hidden="true" size="16" aria-hidden="true">
          Delete
          <text class="bg-background text-muted-foreground/70 -me-1 inline-flex h-5 max-h-full items-center rounded border px-1 text-[0.625rem] font-medium">
            
          </text>
        </button>

        <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">
          <text aria-hidden="true" size="16" aria-hidden="true">
          Add user
        </button>
      </view>
    </view>

    <view class="bg-background overflow-hidden rounded-md border">
      <view data-slot="table">
        <view>
          <view>
            <text>
              <input type="checkbox" data-slot="checkbox"
                aria-label="Select all">
            </text>
            <text>Name</text>
            <text>
              
            </text>
          </view>
        </view>

        <view>
          <view>
            <view>
              <text>
                <input type="checkbox" data-slot="checkbox" aria-label="Select Example">
              </text>

              <text></text>

              <text></text>
              <text> </text>
              <text>
                <text data-slot="badge">
                  
                </text>
              </text>
              <text></text>
              <text></text>
            </view>
</view>
