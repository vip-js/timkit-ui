<view class="timui-html-demo space-y-4 p-4">
<view class="space-y-4">
    <view class="bg-background overflow-hidden rounded-md border">
      <view data-slot="table">
        <view>
          <view>
            <text>
              <text class="flex items-center gap-1">Name <component size="14"></text>
            </text>
            <text>
              <text class="flex items-center gap-1">Email <component size="14"></text>
            </text>
            <text>
              <text class="flex items-center gap-1">Location <component size="14"></text>
            </text>
            <text>
              <text class="flex items-center gap-1">Status <component size="14"></text>
            </text>
            <text>
              <text class="flex items-center justify-end gap-1">Balance <component size="14"></text>
            </text>
          </view>
        </view>

        <view>
          <view>
            <text></text>
            <text></text>
            <text> </text>
            <text></text>
            <text></text>
          </view>
        </view>
      </view>
    </view>

    <view class="flex items-center justify-between gap-4 max-sm:flex-col">
      <text class="text-muted-foreground text-sm" aria-live="polite"></text>

      <view class="flex items-center gap-2">
        <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" size="icon" variant="outline" aria-label="Go to first page">
          <text aria-hidden="true" size="16">
        </button>
        <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" size="icon" variant="outline" aria-label="Go to previous page">
          <text aria-hidden="true" size="16">
        </button>
        <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" size="icon" variant="outline" aria-label="Go to next page">
          <text aria-hidden="true" size="16">
        </button>
        <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" size="icon" variant="outline" aria-label="Go to last page">
          <text aria-hidden="true" size="16">
        </button>
      </view>

      <view class="flex items-center gap-2">
        <text data-slot="label" for="table-18-page-size">Rows per page</text>
        <select data-slot="select">
          <button type="button" data-slot="select-trigger" id="table-18-page-size">
            <text data-slot="select-value" placeholder="Page size"></text>
          </button>
          <view data-slot="select-content">
            <view data-slot="select-item" value="5">5</view>
            <view data-slot="select-item" value="10">10</view>
            <view data-slot="select-item" value="25">25</view>
            <view data-slot="select-item" value="50">50</view>
          </view>
        </select>
      </view>
    </view>

    <text class="text-muted-foreground mt-4 text-center text-sm">
      Paginated table made with
      <navigator class="hover:text-foreground underline" href="https://tanstack.com/table" target="_blank" rel="noopener noreferrer">
        TanStack Table
      </navigator>
    </text>
  </view>
</view>
