<view class="timui-html-demo space-y-4 p-4">
<view class="space-y-4">
    <view class="bg-background overflow-hidden rounded-md border">
      <view data-slot="table">
        <view>
          <view>
            <text>Name</text>
            <text>Email</text>
            <text>Location</text>
            <text>Status</text>
            <text>Balance</text>
          </view>
        </view>
        <view>
          <view>
            <text></text>
            <text></text>
            <text> </text>
            <text></text>
            <text></text>
          </view>
        </view>
      </view>
    </view>

    <view class="flex items-center justify-between gap-3 max-sm:flex-col">
      <text class="text-muted-foreground flex-1 text-sm whitespace-nowrap" aria-live="polite">
        Page <text class="text-foreground"></text> of <text class="text-foreground"></text>
      </text>

      <view class="grow">
        <view aria-label="Pagination">
          <view>
            <view>
              <button type="button" data-slot="button" class="disabled:pointer-events-none disabled:opacity-50 inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
                size="icon"
                variant="outline"
               
                aria-label="Go to previous page">
                <text aria-hidden="true" size="16" aria-hidden="true">
              </button>
            </view>

            <view>
              <text aria-hidden="true">
            </view>

            <view>
              <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
                size="icon">
                
              </button>
            </view>

            <view>
              <text aria-hidden="true">
            </view>

            <view>
              <button type="button" data-slot="button" class="disabled:pointer-events-none disabled:opacity-50 inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
                size="icon"
                variant="outline"
               
                aria-label="Go to next page">
                <text aria-hidden="true" size="16" aria-hidden="true">
              </button>
            </view>
          </view>
        </view>
      </view>

      <view class="flex flex-1 justify-end">
        <select data-slot="select" aria-label="Results per page">
          <button type="button" data-slot="select-trigger">
            <text data-slot="select-value" placeholder="Select number of results"></text>
          </button>
          <view data-slot="select-content">
            <view data-slot="select-item" value="5">5 / page</view>
            <view data-slot="select-item" value="10">10 / page</view>
            <view data-slot="select-item" value="25">25 / page</view>
            <view data-slot="select-item" value="50">50 / page</view>
          </view>
        </select>
      </view>
    </view>

    <text class="text-muted-foreground mt-4 text-center text-sm">
      Numeric pagination made with
      <navigator class="hover:text-foreground underline" href="https://tanstack.com/table" target="_blank" rel="noopener noreferrer">
        TanStack Table
      </navigator>
    </text>
  </view>
</view>
