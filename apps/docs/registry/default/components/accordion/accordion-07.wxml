<view class="space-y-4">
  <view class="text-xl font-bold">W/ sub-header and chevron</view>
  <accordion type="single" collapsible class="w-full" bind:change="handleValueChange" value="{{value}}">
    <block wx:for="{{items}}" wx:key="id" wx:for-index="itemIndex" wx:for-item="item">
      <accordion-item value="{{item.id}}" class="py-2">
        <view slot="trigger" class="focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-center justify-between rounded-md py-2 text-left text-[15px] leading-6 font-semibold transition-all outline-none focus-visible:ring-[3px] [&[data-state=open]>svg]:rotate-180">
          <view class="flex flex-col space-y-1">
            <text>{{item.title}}</text>
            <text wx:if="{{item.sub}}" class="text-sm font-normal">{{item.sub}}</text>
          </view>
        </view>
        <view slot="icon" class="h-4 w-4 shrink-0 opacity-60 transition-transform duration-200">
          <text class="text-sm font-semibold">v</text>
        </view>
<view slot="content" class="text-muted-foreground pb-2">{{item.content}}</view>
      </accordion-item>
    </block>
  </accordion>
</view>