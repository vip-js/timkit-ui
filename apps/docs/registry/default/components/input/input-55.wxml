        })}}" /><text class="text-muted-foreground mt-2 text-xs" role="region" aria-live="polite">Built with{{ ' ' }}<a class="hover:text-foreground underline" href="https://github.com/eduardoborges/use-mask-input" target="_blank" rel="noopener nofollow">use-mask-input
        </a></text></view>
</view>