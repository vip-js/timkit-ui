<view class="timui-html-demo space-y-4 p-4">
<view class="*:not-first:mt-2">
    <text data-slot="label">Number input with chevrons</text>
    <view class="border-input bg-background relative inline-flex h-9 w-full items-center overflow-hidden rounded-md border text-sm shadow-xs">
      <input data-slot="input" class="h-full rounded-none border-0 tabular-nums shadow-none flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" value="€NaN" readonly>
      <view class="flex h-full flex-col border-l">
        <button type="button" data-slot="button" class="h-1/2 w-8 rounded-none border-b inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
          type="button"
          size="icon"
          variant="ghost"
         
          aria-label="Increase value">
          <text aria-hidden="true" size="12" aria-hidden="true">
        </button>
        <button type="button" data-slot="button" class="h-1/2 w-8 rounded-none inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
          type="button"
          size="icon"
          variant="ghost"
         
          aria-label="Decrease value">
          <text aria-hidden="true" size="12" aria-hidden="true">
        </button>
      </view>
    </view>
    <text class="text-muted-foreground mt-2 text-xs" role="region" aria-live="polite">
      Built with TimUI atomic components
    </text>
  </view>
</view>
