<view class="*:not-first:mt-2">
      <label for="input-17-id">Input with start select</label>
      <view class="flex rounded-md shadow-xs">
        <select-native class="text-muted-foreground hover:text-foreground w-fit rounded-e-none shadow-none">
          <option value="https://">https://</option>
          <option value="http://">http://</option>
          <option value="ftp://">ftp://</option>
          <option value="sftp://">sftp://</option>
          <option value="ws://">ws://</option>
          <option value="wss://">wss://</option>
        </select-native>
        <input id="input-17-id"
          class="-ms-px rounded-s-none shadow-none focus-visible:z-10"
          placeholder="192.168.1.1"
          type="text"
        />
      </view>
    </view>