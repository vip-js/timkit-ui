<view class="timui-html-demo space-y-4 p-4">
<view data-slot="date-range-picker">
    <text data-slot="label">Date range picker (unavailable dates)</text>

    <view class="flex">
      <view data-slot="group">
        <text aria-hidden="true" data-slot="start" unstyled>
        <text aria-hidden="true" class="text-muted-foreground/70 px-2">-</text>
        <text aria-hidden="true" data-slot="end" unstyled>
      

      <view data-slot="date-range-picker-trigger">
        <text aria-hidden="true" size="16">
      
    </view>

    <view data-slot="date-range-picker-content">
      <view class="max-h-[inherit] overflow-auto p-2">
        <text aria-hidden="true">
      </view>
    

    <text class="text-destructive mt-1 text-xs" role="alert">
      
    </text>

    <text class="text-muted-foreground mt-2 text-xs" role="region" aria-live="polite">
      Built with
      <navigator
        class="hover:text-foreground underline"
        href="https://react-spectrum.adobe.com/react-aria/DateRangePicker.html"
        target="_blank"
        rel="noopener nofollow">
        React Aria
      </navigator>
    </text>
</view>
