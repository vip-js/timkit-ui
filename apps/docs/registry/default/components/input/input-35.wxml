<view>
  <view class="*:not-first:mt-2"><label htmlfor="{{id}}">Input with characters left</label><input id="{{id}}" type="text" value="{{value}}" maxlength="{{maxLength}}" onchange="{{handleChange}}" aria-describedby="{{`${id}-description`}}" /><text id="{{`${id}-description`}}" class="text-muted-foreground mt-2 text-xs" role="status" aria-live="polite"><text class="tabular-nums">{{ limit - characterCount }}</text>characters left
      </text></view>
</view>