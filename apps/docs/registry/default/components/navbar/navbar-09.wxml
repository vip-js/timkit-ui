<view class="timui-html-demo space-y-4 p-4">
<view class="border-b px-4 md:px-6">
    <view class="flex h-16 items-center justify-between gap-4">
      <view class="flex flex-1 items-center gap-2">
        <view data-slot="popover">
          <button type="button" data-slot="popover-trigger">
            <button type="button" data-slot="button" class="group size-8 md:hidden inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="icon">
              
            </button>
          </button>
          <view data-slot="popover-content" align="start">
            <view aria-label="Main">
              <view>
                <view>
                  <navigator href="#">
                    <component size="16" class="text-muted-foreground" aria-hidden="true">
                    <text></text>
                  </navigator>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="flex items-center gap-6">
          <navigator href="#" class="text-primary hover:text-primary/90">
            <text aria-hidden="true">
          </navigator>
          <view class="relative">
            <input data-slot="input" class="peer h-8 ps-8 pe-2 flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" placeholder="Search..." type="search">
            <view class="text-muted-foreground/80 pointer-events-none absolute inset-y-0 start-0 flex items-center justify-center ps-2 peer-disabled:opacity-50">
              <text aria-hidden="true" size="16">
            </view>
          </view>
        </view>
      </view>

      <view aria-label="Main">
        <view>
          <view>
            <navigator href="#">
              <component aria-hidden="true">
              <text class="sr-only"></text>
            </navigator>
          </view>
        </view>
      </view>

      <view class="flex flex-1 items-center justify-end gap-4">
        <view class="flex items-center gap-2">
          <button type="button" data-slot="button" class="text-muted-foreground relative size-8 rounded-full shadow-none inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
            size="icon"
            variant="ghost"
           
            aria-label="Open notifications">
            <text aria-hidden="true" size="16" aria-hidden="true">
            <view aria-hidden="true" class="bg-primary absolute top-0.5 right-0.5 size-1 rounded-full">
          </button>
          <text aria-hidden="true">
        </view>
        <text aria-hidden="true">
      </view>
    </view>
  </view>
</view>
