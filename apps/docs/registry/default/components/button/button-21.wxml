<view>
  <button class="group rounded-full" variant="outline" size="icon" bindtap="setOpen((prevState) => !prevState)" aria-expanded="{{open}}" aria-label="{{open ? 'Close menu' : 'Open menu'}}"><plusicon class="transition-transform duration-500 ease-[cubic-bezier(0.68,-0.6,0.32,1.6)] group-aria-expanded:rotate-[135deg]" size="{{16}}" aria-hidden="true" /></button>
</view>