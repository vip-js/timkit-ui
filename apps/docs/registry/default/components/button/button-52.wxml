<view>
  <view class="flex flex-col items-center gap-2"><view class="relative inline-flex"><button variant="outline" class="relative size-16 overflow-hidden p-0 shadow-none" bindtap="openFileDialog" aria-label="{{previewUrl ? 'Change image' : 'Upload image'}}"><block wx:if="{{previewUrl}}">
<image class="size-full object-cover" src="{{previewUrl}}" alt="Preview of uploaded image" width="{{64}}" height="{{64}}" style="{{{ objectFit: 'cover' }}}" />
</block>
<block wx:else>
<view aria-hidden="true"><circleuserroundicon class="size-4 opacity-60" /></view>
</block></button><button wx:if="{{previewUrl}}" bindtap="removeFile(files[0]?.id)" size="icon" class="border-background focus-visible:border-background absolute -top-2 -right-2 size-6 rounded-full border-2 shadow-none" aria-label="Remove image"><xicon class="size-3.5" /></button><input class="sr-only" aria-label="Upload image file" tabindex="{{-1}}" /></view><text wx:if="{{fileName}}" class="text-muted-foreground text-xs">{{ fileName }}</text><text aria-live="polite" role="region" class="text-muted-foreground mt-2 text-xs">Avatar upload button
      </text></view>
</view>