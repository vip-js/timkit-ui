<view>
  <button class="gap-1" variant="ghost" bindtap="toggleExpand" aria-expanded="{{isExpanded}}" aria-controls="expandable-content">{{ isExpanded ? 'Show less' : 'Show more' }}{{ isExpanded ? (
        <ChevronUpIcon className="-me-1" size={16} aria-hidden="true" />
      ) : (
        <ChevronDownIcon className="-me-1" size={16} aria-hidden="true" />
      ) }}</button>
</view>