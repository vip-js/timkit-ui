<view class="timui-html-demo space-y-4 p-4">
<view data-slot="popover">
    <button type="button" data-slot="popover-trigger">
      <button type="button" data-slot="button" class="text-muted-foreground relative size-8 rounded-full shadow-none inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
        size="icon"
        variant="ghost"
       
        aria-label="Open notifications">
        <text aria-hidden="true" size="16" aria-hidden="true">
        <view aria-hidden="true" class="bg-primary absolute top-0.5 right-0.5 size-1 rounded-full">
      </button>
    </button>
    <view data-slot="popover-content">
      <view class="flex items-baseline justify-between gap-4 px-3 py-2">
        <view class="text-sm font-semibold">Notifications</view>
        <button class="text-xs font-medium hover:underline">
          Mark all as read
        </button>
      </view>
      <view role="separator" aria-orientation="horizontal" class="bg-border -mx-1 my-1 h-px">
      <view
        class="hover:bg-accent rounded-md px-3 py-2 text-sm transition-colors">
        <view class="relative flex items-start pe-3">
          <view class="flex-1 space-y-1">
            <button
              class="text-foreground/80 text-left after:absolute after:inset-0">
              <text class="text-foreground font-medium hover:underline"></text>
                
              <text class="text-foreground font-medium hover:underline"></text>.
            </button>
            <view class="text-muted-foreground text-xs"></view>
          </view>
          <view class="absolute end-0 self-center">
            <text class="sr-only">Unread</text>
            
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
