<view class="timui-html-demo space-y-4 p-4">
<view class="mx-auto max-w-xl space-y-8 text-center"><view role="group" aria-label="Stepper"><view data-slot="stepper-item"><view data-slot="stepper-trigger"><text aria-hidden="true"><text aria-hidden="true"></view><view class="flex justify-center space-x-4"><button type="button" data-slot="button" class="w-32 inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline"="setCurrentStep((prev) => prev - 1)">Prev step
        </button><button type="button" data-slot="button" class="w-32 inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">Next step
        </button></view><text class="text-muted-foreground mt-2 text-xs" role="region" aria-live="polite">Controlled stepper with checkmarks and loading state
      </text></view>
</view>
