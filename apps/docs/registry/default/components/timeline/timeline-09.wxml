<view>
  <timeline class="divide-y rounded-lg border"><timelineitem wx:for="{{items}}" wx:for-item="item" wx:for-index="index" wx:key="index" key="{{item.id}}" step="{{item.id}}" class="m-0! px-4! py-3!"><timelinecontent class="text-foreground">{{ item.description }}<timelinedate class="mt-1">{{ item.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              }) }}{{ ' ' }}at{{ ' ' }}{{ item.date.toLocaleTimeString('en-US', {
                hour: 'numeric',
                minute: '2-digit',
                hour12: true,
              }) }}</timelinedate></timelinecontent></timelineitem></timeline>
</view>