<view>
  <view><view class="rounded-md border"><view class="flex max-sm:flex-col"><view class="relative py-4 max-sm:order-1 max-sm:border-t sm:w-32"><view class="h-full sm:border-e"><view class="flex flex-col px-2"><button variant="ghost" size="sm" class="w-full justify-start" bindtap="{
                    setDate({
                      from: today,
                      to: today,
                    })
                    setMonth(today)
                  }">Today
                </button><button variant="ghost" size="sm" class="w-full justify-start" bindtap="{
                    setDate(yesterday)
                    setMonth(yesterday.to)
                  }">Yesterday
                </button><button variant="ghost" size="sm" class="w-full justify-start" bindtap="{
                    setDate(last7Days)
                    setMonth(last7Days.to)
                  }">Last 7 days
                </button><button variant="ghost" size="sm" class="w-full justify-start" bindtap="{
                    setDate(last30Days)
                    setMonth(last30Days.to)
                  }">Last 30 days
                </button><button variant="ghost" size="sm" class="w-full justify-start" bindtap="{
                    setDate(monthToDate)
                    setMonth(monthToDate.to)
                  }">Month to date
                </button><button variant="ghost" size="sm" class="w-full justify-start" bindtap="{
                    setDate(lastMonth)
                    setMonth(lastMonth.to)
                  }">Last month
                </button><button variant="ghost" size="sm" class="w-full justify-start" bindtap="{
                    setDate(yearToDate)
                    setMonth(yearToDate.to)
                  }">Year to date
                </button><button variant="ghost" size="sm" class="w-full justify-start" bindtap="{
                    setDate(lastYear)
                    setMonth(lastYear.to)
                  }">Last year
                </button></view></view></view><calendar mode="range" selected="{{date}}" bindchange="{
              if (newDate) {
                setDate(newDate as CalendarRangeValue)
              }
            }" month="{{month}}" onmonthchange="{{setMonth}}" class="p-2" disabled="{{[
              { after: today }, // Dates before today
            ]}}" /></view></view><text class="text-muted-foreground mt-4 text-center text-xs" role="region" aria-live="polite">Range calendar with presets -{{ ' ' }}<a class="hover:text-foreground underline" href="https://daypicker.dev/" target="_blank" rel="noopener nofollow">React DayPicker
        </a></text></view>
</view>