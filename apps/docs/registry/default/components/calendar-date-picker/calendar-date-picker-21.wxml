<view class="timui-html-demo space-y-4 p-4">
<view>
    <view class="rounded-md border">
      <view class="flex max-sm:flex-col">
        <view class="relative py-4 max-sm:order-1 max-sm:border-t sm:w-32">
          <view class="h-full sm:border-e">
            <view class="flex flex-col px-2">
              <button type="button" data-slot="button" class="w-full justify-start inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="sm">Today</button>
              <button type="button" data-slot="button" class="w-full justify-start inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="sm">Yesterday</button>
              <button type="button" data-slot="button" class="w-full justify-start inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="sm">Last 7 days</button>
              <button type="button" data-slot="button" class="w-full justify-start inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="sm">Last 30 days</button>
              <button type="button" data-slot="button" class="w-full justify-start inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="sm">Month to date</button>
              <button type="button" data-slot="button" class="w-full justify-start inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="sm">Last month</button>
              <button type="button" data-slot="button" class="w-full justify-start inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="sm">Year to date</button>
              <button type="button" data-slot="button" class="w-full justify-start inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="ghost" size="sm">Last year</button>
            </view>
          </view>
        </view>
        <text aria-hidden="true"
          mode="range">
      </view>
    </view>
    <text class="text-muted-foreground mt-4 text-center text-xs" role="region" aria-live="polite">
      Range calendar with presets -
      <navigator class="hover:text-foreground underline" href="https://daypicker.dev/" target="_blank" rel="noopener nofollow">
        React DayPicker
      </navigator>
    </text>
  </view>
</view>
