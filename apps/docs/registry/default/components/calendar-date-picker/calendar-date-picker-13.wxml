<view>
  <view><calendar mode="single" selected="{{date}}" bindchange="setDate" class="rounded-md border p-2" fixedweeks showweeknumber components="{{{
          WeekNumber: ({ week, ...props }: CalendarWeekNumberProps) => {
            return (
              <th {...props}>
                <span className="inline-flex size-9 items-center justify-center">
                  {week.weekNumber}
                </span>
              </th>
            )
          },
        }}}" /><text class="text-muted-foreground mt-4 text-center text-xs" role="region" aria-live="polite">Weekly numbers -{{ ' ' }}<a class="hover:text-foreground underline" href="https://daypicker.dev/" target="_blank" rel="noopener nofollow">React DayPicker
        </a></text></view>
</view>