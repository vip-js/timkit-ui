<view class="timui-html-demo space-y-4 p-4">
<form>
    <text for="name">Name</text>
    <input
      type="text"
      aria-label="Name">
    <text id="name-error" role="alert"></text>
    <text for="email">Email</text>
    <input
      type="email"
      aria-label="Email">
    <text id="email-error" role="alert"></text>
    <text>
      <input
        type="checkbox"
        aria-label="Accept terms">
      Accept terms
    </text>
    <text id="terms-error" role="alert"></text>
    <button type="submit">Create account</button>
    <text></text>
  </form>
</view>
