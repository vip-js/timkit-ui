<form>
  <label>Name</label>
  <input type="text" aria-label="Name" aria-invalid="true" aria-describedby="name-error" />
  <view id="name-error">Use at least 2 characters</view>
  <label>Email</label>
  <input type="text" aria-label="Email" aria-invalid="true" aria-describedby="email-error" />
  <view id="email-error">Email is required</view>
  <label>Accept terms</label>
  <checkbox aria-label="Accept terms" aria-invalid="true" aria-describedby="terms-error" />
  <view id="terms-error">Accept terms</view>
  <button type="submit">Create account</button>
</form>
