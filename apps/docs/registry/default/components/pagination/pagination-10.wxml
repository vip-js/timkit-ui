rentPage === totalPages ? 'link' : undefined}}"><chevronrighticon size="{{16}}" aria-hidden="true" /></paginationlink></paginationitem><paginationitem><paginationlink class="aria-disabled:pointer-events-none aria-disabled:opacity-50" href="{{currentPage === totalPages ? undefined : `#/page/${totalPages}`}}" aria-label="Go to last page" aria-disabled="{{currentPage === totalPages ? true : undefined}}" role="{{currentPage === totalPages ? 'link' : undefined}}"><chevronlasticon size="{{16}}" aria-hidden="true" /></paginationlink></paginationitem></paginationcontent></pagination></view></view>
