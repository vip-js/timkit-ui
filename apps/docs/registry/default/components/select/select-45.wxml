<view class="timui-html-demo space-y-4 p-4">
<view class="*:not-first:mt-2">
    <text data-slot="label">Options with icon and number</text>

    <view data-slot="popover">
      <button type="button" data-slot="popover-trigger">
        <button type="button" data-slot="button" class="bg-background hover:bg-background border-input w-full justify-between px-3 font-normal outline-offset-0 outline-none focus-visible:outline-[3px] inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
          variant="outline"
          role="combobox">
          <text class="flex min-w-0 items-center gap-2">
            <component class="text-muted-foreground size-4">
            <text class="truncate"></text>
          </text>
          <text class="text-muted-foreground">Select service category</text>

          <text aria-hidden="true" size="16" aria-hidden="true">
        </button>
      </button>

      <view data-slot="popover-content" align="start">
        <view role="listbox">
          <input type="search" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" placeholder="Search services...">
          <view>
            <text>No service found.</text>
            <view>
              <button type="button" role="option">
                <view class="flex items-center gap-2">
                  <component class="text-muted-foreground size-4">
                  Example
                </view>
                <text class="text-muted-foreground text-xs"></text>
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
