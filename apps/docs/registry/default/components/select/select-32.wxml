<view class="timui-html-demo space-y-4 p-4">
<view class="*:not-first:mt-2">
    <text data-slot="label" for="select-32">Status select</text>
    <select data-slot="select">
      <button type="button" data-slot="select-trigger" id="select-32" class="[&>span]:flex [&>span]:items-center [&>span]:gap-2 [&>span_svg]:shrink-0">
        <text data-slot="select-value" placeholder="Select status"></text>
      </button>
      <view data-slot="select-content" class="[&_*[role=option]>span>svg]:text-muted-foreground/80 [&_*[role=option]]:ps-2 [&_*[role=option]]:pe-8 [&_*[role=option]>span]:start-auto [&_*[role=option]>span]:end-2 [&_*[role=option]>span]:flex [&_*[role=option]>span]:items-center [&_*[role=option]>span]:gap-2 [&_*[role=option]>span>svg]:shrink-0">
        <view data-slot="select-item" value="1">
          <text class="flex items-center gap-2">
            
            <text class="truncate">Completed</text>
          </text>
        </view>
        <view data-slot="select-item" value="2">
          <text class="flex items-center gap-2">
            
            <text class="truncate">In Progress</text>
          </text>
        </view>
        <view data-slot="select-item" value="3">
          <text class="flex items-center gap-2">
            
            <text class="truncate">Pending</text>
          </text>
        </view>
        <view data-slot="select-item" value="4">
          <text class="flex items-center gap-2">
            
            <text class="truncate">Cancelled</text>
          </text>
        </view>
        <view data-slot="select-item" value="5">
          <text class="flex items-center gap-2">
            
            <text class="truncate">Failed</text>
          </text>
        </view>
      </view>
    </select>
  </view>
</view>
