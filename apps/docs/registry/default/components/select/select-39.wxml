<view class="timui-html-demo space-y-4 p-4">
<view class="*:not-first:mt-2">
    <text data-slot="label" for="select-39">Options with placeholder avatar</text>
    <select data-slot="select">
      <button type="button" data-slot="select-trigger" id="select-39" class="ps-2 [&>span]:flex [&>span]:items-center [&>span]:gap-2 [&>span_[data-square]]:shrink-0">
        <text data-slot="select-value" placeholder="Select framework"></text>
      </button>
      <view data-slot="select-content" class="[&_*[role=option]]:ps-2 [&_*[role=option]]:pe-8 [&_*[role=option]>span]:start-auto [&_*[role=option]>span]:end-2 [&_*[role=option]>span]:flex [&_*[role=option]>span]:items-center [&_*[role=option]>span]:gap-2">
        <view>
          <text>Impersonate user</text>
          <view data-slot="select-item" value="1">
            <text data-square aria-hidden="true">F</text>
            <text class="truncate">Frank Morris</text>
          </view>
          <view data-slot="select-item" value="2">
            <text data-square aria-hidden="true">X</text>
            <text class="truncate">Xavier Guerra</text>
          </view>
          <view data-slot="select-item" value="3">
            <text data-square aria-hidden="true">A</text>
            <text class="truncate">Anne Kelley</text>
          </view>
        </view>
      </view>
    </select>
  </view>
</view>
