<view class="timui-html-demo space-y-4 p-4">
<view class="*:not-first:mt-2">
    <text data-slot="label">Listbox with multiple options</text>
    <view class="border-input overflow-hidden rounded-md border">
      <view data-slot="list-box"
       
        aria-label="Select framework"
        selectionMode="multiple">
        <view data-slot="list-box-item"
          id="react">
          React
        
        <view data-slot="list-box-item"
          id="vue">
          Vue
        
        <view data-slot="list-box-item"
          id="angular">
          Angular
        
        <view data-slot="list-box-item"
          id="svelte">
          Svelte
        
      
    </view>
    <text class="text-muted-foreground mt-2 text-xs" role="region" aria-live="polite">
      Built with
      <navigator
        class="hover:text-foreground underline"
        href="https://zagjs.com/"
        target="_blank"
        rel="noopener nofollow">
        Zag.js
      </navigator>
    </text>
  </view>
</view>
