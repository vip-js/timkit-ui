<view class="timui-html-demo space-y-4 p-4">
<view class="*:not-first:mt-2">
    <text data-slot="label">Options with flag and search</text>
    <view data-slot="popover">
      <button type="button" data-slot="popover-trigger">
        <button type="button" data-slot="button" class="bg-background hover:bg-background border-input w-full justify-between px-3 font-normal outline-offset-0 outline-none focus-visible:outline-[3px] inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground"
          variant="outline"
          role="combobox">
          <view>
            <text class="flex min-w-0 items-center gap-2">
              <text class="text-lg leading-none"></text>
              <text class="truncate"></text>
            </text>
</view>
