<view class="timui-html-demo space-y-4 p-4">
<view class="*:not-first:mt-2">
    <text data-slot="label">Listbox with option groups</text>
    <view class="border-input overflow-hidden rounded-md border">
      <view data-slot="list-box"
       
        aria-label="Select some foods"
        selectionMode="multiple">
        <view data-slot="list-box-section">
          <view data-slot="header">Veggies
          <view data-slot="list-box-item"
            id="lettuce">
            Lettuce
          
          <view data-slot="list-box-item"
            id="tomato">
            Tomato
          
          <view data-slot="list-box-item"
            id="onion">
            Onion
          
        

        <view data-slot="separator">

        <view data-slot="list-box-section">
          <view data-slot="header">Protein
          <view data-slot="list-box-item"
            id="ham">
            Ham
          
          <view data-slot="list-box-item"
            id="tuna">
            Tuna
          
          <view data-slot="list-box-item"
            id="tofu">
            Tofu
          
        

        <view data-slot="separator">

        <view data-slot="list-box-section">
          <view data-slot="header">Condiments
          <view data-slot="list-box-item"
            id="mayo">
            Mayonaise
          
          <view data-slot="list-box-item"
            id="mustard">
            Mustard
          
          <view data-slot="list-box-item"
            id="ranch">
            Ranch
          
        
      
    </view>

    <text class="text-muted-foreground mt-2 text-xs" role="region" aria-live="polite">
      Built with
      <navigator
        class="hover:text-foreground underline"
        href="https://zagjs.com/"
        target="_blank"
        rel="noopener nofollow">
        Zag.js
      </navigator>
    </text>
  </view>
</view>
