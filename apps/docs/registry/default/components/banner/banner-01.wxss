.banner-container {
  background-color: #fff;
  z-index: 50;
  border-radius: 6px;
  border: 1px solid #e2e8f0; /* border-input */
  padding: 12px 16px;
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.banner-content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

@media (min-width: 640px) {
  .banner-content {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

.banner-text {
  font-size: 14px;
  color: #09090b; /* foreground */
}

.banner-actions {
  display: flex;
  gap: 8px;
}

.btn-primary {
  background-color: #18181b;
  color: #fff;
  font-size: 12px;
}

.btn-outline {
  background-color: transparent;
  color: #18181b;
  border: 1px solid #e2e8f0;
  font-size: 12px;
}
