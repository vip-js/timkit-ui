<view>
  <view class="group inline-flex items-center gap-2" data-state="{{checked ? 'checked' : 'unchecked'}}"><text id="{{`${id}-off`}}" class="group-data-[state=checked]:text-muted-foreground/70 flex-1 cursor-pointer text-right text-sm font-medium" aria-controls="{{id}}" bindtap="setChecked(false)"><moonicon size="{{16}}" aria-hidden="true" /></text><switch id="{{id}}" checked="{{checked}}" oncheckedchange="{{toggleSwitch}}" aria-labelledby="{{`${id}-off ${id}-on`}}" aria-label="Toggle between dark and light mode" /><text id="{{`${id}-on`}}" class="group-data-[state=unchecked]:text-muted-foreground/70 flex-1 cursor-pointer text-left text-sm font-medium" aria-controls="{{id}}" bindtap="setChecked(true)"><sunicon size="{{16}}" aria-hidden="true" /></text></view>
</view>