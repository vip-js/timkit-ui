<view class="timui-html-demo space-y-4 p-4">
<view data-slot="dialog">
    <button type="button" data-slot="dialog-trigger" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
      <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">OTP code</button>
    </button>
    <view data-slot="dialog-content">
      <view class="flex flex-col items-center gap-2">
        <view class="flex size-11 shrink-0 items-center justify-center rounded-full border" aria-hidden="true">
          
        </view>
        <view data-slot="dialog-header">
          <text data-slot="dialog-title"></text>
          <text data-slot="dialog-description">
            
          </text>
        </view>
      </view>

      <view>
        <view class="text-center">
          <view data-slot="dialog-close">
            <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" type="button">Close</button>
          
        </view>
</view>
