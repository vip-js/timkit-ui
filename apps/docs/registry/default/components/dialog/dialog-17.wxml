<view class="timui-html-demo space-y-4 p-4">
<view data-slot="dialog">
    <button type="button" data-slot="dialog-trigger" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
      <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">Checkout</button>
    </button>
    <view data-slot="dialog-content">
      <view class="mb-2 flex flex-col gap-2">
        <view class="flex size-11 shrink-0 items-center justify-center rounded-full border" aria-hidden="true">
          <text aria-hidden="true" size="16">
        </view>
        <view data-slot="dialog-header">
          <text data-slot="dialog-title">Confirm and pay</text>
          <text data-slot="dialog-description">Pay securely and cancel any time.</text>
        </view>
      </view>

      <form class="space-y-5">
        <view class="space-y-4">
          <view role="radiogroup" data-slot="radio-group">
            <text class="border-input has-data-[state=checked]:border-primary/50 has-focus-visible:border-ring has-focus-visible:ring-ring/50 relative flex cursor-pointer flex-col gap-1 rounded-md border px-4 py-3 shadow-xs transition-[color,box-shadow] outline-none has-focus-visible:ring-[3px]">
              <input type="radio" data-slot="radio-group-item" id="radio-monthly" value="monthly">
              <text class="text-foreground text-sm font-medium">Monthly</text>
              <text class="text-muted-foreground text-sm">$32/month</text>
            </text>
            <text class="border-input has-data-[state=checked]:border-primary/50 has-focus-visible:border-ring has-focus-visible:ring-ring/50 relative flex cursor-pointer flex-col gap-1 rounded-md border px-4 py-3 shadow-xs transition-[color,box-shadow] outline-none has-focus-visible:ring-[3px]">
              <input type="radio" data-slot="radio-group-item" id="radio-yearly" value="yearly">
              <view class="inline-flex items-start justify-between gap-2">
                <text class="text-foreground text-sm font-medium">Yearly</text>
                <text data-slot="badge">Popular</text>
              </view>
              <text class="text-muted-foreground text-sm">$320/month</text>
            </text>
          </view>

          <view class="*:not-first:mt-2">
            <text data-slot="label" for="name-Example">Name on card</text>
            <input data-slot="input" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" id="name-Example" type="text" required>
          </view>

          <view class="*:not-first:mt-2">
            <legend class="text-foreground text-sm font-medium">Card Details</legend>
            <view class="rounded-md shadow-xs">
              <view class="relative focus-within:z-10">
                <input data-slot="input" class="peer rounded-b-none pe-9 shadow-none flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" placeholder="Card number">
                <view class="text-muted-foreground/80 pointer-events-none absolute inset-y-0 end-0 flex items-center justify-center pe-3 peer-disabled:opacity-50">
                  <text aria-hidden="true" size="16" aria-hidden="true">
                </view>
              </view>
              <view class="-mt-px flex">
                <view class="min-w-0 flex-1 focus-within:z-10">
                  <input data-slot="input" class="rounded-e-none rounded-t-none shadow-none flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" placeholder="MM/YY">
                </view>
                <view class="-ms-px min-w-0 flex-1 focus-within:z-10">
                  <input data-slot="input" class="rounded-s-none rounded-t-none shadow-none flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" placeholder="CVC">
                </view>
              </view>
            </view>
          </view>

          <view>
            <button type="button" class="text-sm underline hover:no-underline">+ Add coupon</button>
</view>
