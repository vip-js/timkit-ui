<view class="timui-html-demo space-y-4 p-4">
<view data-slot="dialog">
    <button type="button" data-slot="dialog-trigger" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
      <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">Invite members</button>
    </button>
    <view data-slot="dialog-content">
      <view class="flex flex-col gap-2">
        <view class="flex size-11 shrink-0 items-center justify-center rounded-full border" aria-hidden="true">
          <text aria-hidden="true" size="16">
        </view>
        <view data-slot="dialog-header">
          <text data-slot="dialog-title">Invite team members</text>
          <text data-slot="dialog-description">Invite teammates to earn free components.</text>
        </view>
      </view>

      <form class="space-y-5">
        <view class="space-y-4">
          <view class="*:not-first:mt-2">
            <text data-slot="label">Invite via email</text>
            <view class="space-y-3">
              <input data-slot="input" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" id="team-email-Example"
                placeholder="hi@yourcompany.com"
                type="email"
               ="(value) => handleEmailChange(index, String(value ?? ''))" />
            </view>
          </view>
          <button type="button" class="text-sm underline hover:no-underline">+ Add another</button>
        </view>
        <button type="button" data-slot="button" class="w-full inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" type="button">Send invites</button>
      </form>

      <view class="my-1 border-t">

      <view class="*:not-first:mt-2">
        <text data-slot="label">Invite via magic link</text>
        <view class="relative">
          <input data-slot="input" class="pe-9 flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" type="text" readOnly>
          <view data-slot="tooltip-provider" delayDuration="0">
            <text data-slot="tooltip">
              <button type="button" data-slot="tooltip-trigger">
                <button
                 
                  class="text-muted-foreground/80 hover:text-foreground focus-visible:border-ring focus-visible:ring-ring/50 absolute inset-y-0 end-0 flex h-full w-9 items-center justify-center rounded-e-md transition-[color,box-shadow] outline-none focus:z-10 focus-visible:ring-[3px] disabled:pointer-events-none disabled:cursor-not-allowed">
                  <view>
                    <text aria-hidden="true" size="16" aria-hidden="true">
                  </view>
                  <view>
                    <text aria-hidden="true" size="16" aria-hidden="true">
                  </view>
                </button>
              </button>
              <text role="tooltip" data-slot="tooltip-content">Copy to clipboard</text>
            </text>
          
        </view>
      </view>
    </view>
  </view>
</view>
