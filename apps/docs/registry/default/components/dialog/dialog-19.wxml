<dialog>
      <dialog-trigger asChild>
        <button variant="outline">Edit profile</button>
      </dialog-trigger>
      <dialog-content class="flex flex-col gap-0 overflow-y-visible p-0 sm:max-w-lg [&>button:last-child]:top-3.5">
        <dialog-header class="contents space-y-0 text-left">
          <dialog-title class="border-b px-6 py-4 text-base">Edit profile</dialog-title>
        </dialog-header>
        <dialog-description class="sr-only">
          Make changes to your profile here. You can change your photo and set a username.
        </dialog-description>
        <view class="overflow-y-auto">
          <profile-bg />
          <avatar />
          <view class="px-6 pt-4 pb-6">
            <form class="space-y-4">
              <view class="flex flex-col gap-4 sm:flex-row">
                <view class="flex-1 space-y-2">
                  <label for="dialog-19-id">First name</label>
                  <input id="dialog-19-id"
                    placeholder="Matt"
                    defaultValue="Margaret"
                    type="text"
                    required
                  />
                </view>
                <view class="flex-1 space-y-2">
                  <label for="dialog-19-id">Last name</label>
                  <input id="dialog-19-id"
                    placeholder="Welsh"
                    defaultValue="Villard"
                    type="text"
                    required
                  />
                </view>
              </view>
              <view class="*:not-first:mt-2">
                <label for="dialog-19-id">Username</label>
                <view class="relative">
                  <input id="dialog-19-id"
                    class="peer pe-9"
                    placeholder="Username"
                    defaultValue="margaret-villard-69"
                    type="text"
                    required
                  />
                  <view class="text-muted-foreground/80 pointer-events-none absolute inset-y-0 end-0 flex items-center justify-center pe-3 peer-disabled:opacity-50">
                     <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500"><circle cx="12" cy="12" r="9" /></svg>
                  </view>
                </view>
              </view>
              <view class="*:not-first:mt-2">
                <label for="dialog-19-id">Website</label>
                <view class="flex rounded-md shadow-xs">
                  <span class="border-input bg-background text-muted-foreground -z-10 inline-flex items-center rounded-s-md border px-3 text-sm">
                    https://
                  </span>
                  <input id="dialog-19-id"
                    class="-ms-px rounded-s-none shadow-none"
                    placeholder="yourwebsite.com"
                    defaultValue="www.margaret.com"
                    type="text"
                  />
                </view>
              </view>
              <view class="*:not-first:mt-2">
                <label for="dialog-19-id">Biography</label>
                <textarea id="dialog-19-id"
                  placeholder="Write a few sentences about yourself" aria-describedby="dialog-19-id-description"
                />
                <p id="dialog-19-id"
                  class="text-muted-foreground mt-2 text-right text-xs"
                  role="status"
                  aria-live="polite"
                >
                  <span class="tabular-nums"></span> characters left
                </p>
              </view>
            </form>
          </view>
        </view>
        <dialog-footer class="border-t px-6 py-4">
          <dialog-close asChild>
            <button type="button" variant="outline">
              Cancel
            </button>
          </dialog-close>
          <dialog-close asChild>
            <button type="button">Save changes</button>
          </dialog-close>
        </dialog-footer>
      </dialog-content>
    </dialog>