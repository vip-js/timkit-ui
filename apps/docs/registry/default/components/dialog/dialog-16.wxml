<view class="timui-html-demo space-y-4 p-4">
<view data-slot="dialog">
    <button type="button" data-slot="dialog-trigger" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground">
      <button type="button" data-slot="button" class="inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" variant="outline">Card details</button>
    </button>

    <view data-slot="dialog-content">
      <view class="flex flex-col gap-2">
        <view class="flex size-11 shrink-0 items-center justify-center rounded-full border" aria-hidden="true">
          <text aria-hidden="true" size="16">
        </view>
        <view data-slot="dialog-header">
          <text data-slot="dialog-title">Update your card</text>
          <text data-slot="dialog-description">Your new card will replace your current card.</text>
        </view>
      </view>

      <form class="space-y-5">
        <view class="space-y-4">
          <view class="*:not-first:mt-2">
            <text data-slot="label" for="name-Example">Name on card</text>
            <input data-slot="input" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" id="name-Example" type="text" required autocomplete="cc-name">
          </view>

          <view class="*:not-first:mt-2">
            <text data-slot="label" for="number-Example">Card Number</text>
            <view class="relative">
              <input data-slot="input" class="peer pe-9 [direction:inherit] flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm" id="number-Example"
               
                inputmode="numeric"
                autocomplete="cc-number">
              <view class="text-muted-foreground/80 pointer-events-none absolute inset-y-0 end-0 flex items-center justify-center pe-3 peer-disabled:opacity-50">
                <text class="text-[10px] font-medium tracking-wide"></text>
                <text aria-hidden="true" size="16" aria-hidden="true">
              </view>
            </view>
          </view>

          <view class="flex gap-4">
            <view class="flex-1 space-y-2">
              <text data-slot="label" for="expiry-Example">Expiry date</text>
              <input data-slot="input" class="[direction:inherit] flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm"
                id="expiry-Example"
                inputmode="numeric"
                autocomplete="cc-exp"
                placeholder="MM/YY">
            </view>
            <view class="flex-1 space-y-2">
              <text data-slot="label" for="cvc-Example">CVC</text>
              <input data-slot="input" class="[direction:inherit] flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm"
                id="cvc-Example"
                inputmode="numeric"
                autocomplete="cc-csc">
            </view>
          </view>
        </view>

        <view class="flex items-center gap-2">
          <input type="checkbox" data-slot="checkbox" id="primary-Example">
          <text data-slot="label" for="primary-Example">
            Set as default payment method
          </text>
        </view>

        <button type="button" data-slot="button" class="w-full inline-flex items-center justify-center rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground" type="button">Update card</button>
      </form>
    </view>
  </view>
</view>
