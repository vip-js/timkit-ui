\"text-muted-foreground mt-2 text-xs\" role=\"region\" aria-live=\"polite\">\n        Built with \n        <a\n          class=\"hover:text-foreground underline\"\n          href=\"https://github.com/guilhermerodz/input-otp\"\n          target=\"_blank\"\n          rel=\"noopener nofollow\"\n        >\n          Input OTP\n        </a>\n      </p>\n    </div>\n</template>\n"
