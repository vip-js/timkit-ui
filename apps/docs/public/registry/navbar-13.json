or> / </breadcrumb-separator>\n              <breadcrumb-item>\n                <select defaultValue=\"1\">\n                  <select-trigger aria-label=\"Select project\" asChild>\n                    <button\n                      variant=\"ghost\"\n                      class=\"focus-visible:bg-accent text-foreground h-8 p-1.5 focus-visible:ring-0\"\n                    >\n                      <select-value placeholder=\"Select project\" />\n                      <chevrons-up-down size=\"14\" class=\"text-muted-foreground/80\" />\n                    </button>\n                  </select-trigger>\n                  <select-content class=\"[&_*[role=option]]:ps-2 [&_*[role=option]]:pe-8 [&_*[role=option]>span]:start-auto [&_*[role=option]>span]:end-2\">\n                    <select-item value=\"1\">Main project</select-item>\n                    <select-item value=\"2\">Origin project</select-item>\n                  </select-content>\n                </select>\n              </breadcrumb-item>\n            </breadcrumb-list>\n          </breadcrumb>\n        </div>\n        \n        <div class=\"flex items-center gap-4\">\n          <div class=\"flex items-center gap-2\">\n            \n            <navigation-menu class=\"max-md:hidden\">\n              <navigation-menu-list class=\"gap-2\">\n                \n                  <navigation-menu-item>\n                    <navigation-menu-link\n                      class=\"text-muted-foreground hover:text-primary py-1.5 font-medium\"\n                    >\n                      \n                    </navigation-menu-link>\n                  </navigation-menu-item>\n                \n\n                  <navigation-menu-item>\n                    <navigation-menu-link\n                      class=\"text-muted-foreground hover:text-primary py-1.5 font-medium\"\n                    >\n                      \n                    </navigation-menu-link>\n                  </navigation-menu-item>\n                \n\n                  <navigation-menu-item>\n                    <navigation-menu-link\n                      class=\"text-muted-foreground hover:text-primary py-1.5 font-medium\"\n                    >\n                      \n                    </navigation-menu-link>\n                  </navigation-menu-item>\n                \n              </navigation-menu-list>\n            </navigation-menu>\n            \n            <settings-menu />\n          </div>\n          \n          <user-menu />\n        </div>\n      </div>\n    </header>"
