aceholder=\"Select account type\" />\n                      <ChevronsUpDown size=\"14\" class=\"text-muted-foreground/80\" />\n                    </Button>\n                  </SelectTrigger>\n                  <SelectContent class=\"[&_*[role=option]]:ps-2 [&_*[role=option]]:pe-8 [&_*[role=option]>span]:start-auto [&_*[role=option]>span]:end-2\">\n                    <SelectItem value=\"personal\">Personal</SelectItem>\n                    <SelectItem value=\"team\">Team</SelectItem>\n                    <SelectItem value=\"business\">Business</SelectItem>\n                  </SelectContent>\n                </Select>\n              </BreadcrumbItem>\n              <BreadcrumbSeparator> / </BreadcrumbSeparator>\n              <BreadcrumbItem>\n                <Select defaultValue=\"1\">\n                  <SelectTrigger aria-label=\"Select project\" asChild>\n                    <Button\n                      variant=\"ghost\"\n                      class=\"focus-visible:bg-accent text-foreground h-8 p-1.5 focus-visible:ring-0\"\n                    >\n                      <SelectValue placeholder=\"Select project\" />\n                      <ChevronsUpDown size=\"14\" class=\"text-muted-foreground/80\" />\n                    </Button>\n                  </SelectTrigger>\n                  <SelectContent class=\"[&_*[role=option]]:ps-2 [&_*[role=option]]:pe-8 [&_*[role=option]>span]:start-auto [&_*[role=option]>span]:end-2\">\n                    <SelectItem value=\"1\">Main project</SelectItem>\n                    <SelectItem value=\"2\">Origin project</SelectItem>\n                  </SelectContent>\n                </Select>\n              </BreadcrumbItem>\n            </BreadcrumbList>\n          </Breadcrumb>\n        </div>\n        \n        <div class=\"flex items-center gap-4\">\n          <div class=\"flex items-center gap-2\">\n            \n            <NavigationMenu class=\"max-md:hidden\">\n              <NavigationMenuList class=\"gap-2\">\n                \n                  <NavigationMenuItem>\n                    <NavigationMenuLink\n                      class=\"text-muted-foreground hover:text-primary py-1.5 font-medium\"\n                    >\n                      \n                    </NavigationMenuLink>\n                  </NavigationMenuItem>\n                \n\n                  <NavigationMenuItem>\n                    <NavigationMenuLink\n                      class=\"text-muted-foreground hover:text-primary py-1.5 font-medium\"\n                    >\n                      \n                    </NavigationMenuLink>\n                  </NavigationMenuItem>\n                \n\n                  <NavigationMenuItem>\n                    <NavigationMenuLink\n                      class=\"text-muted-foreground hover:text-primary py-1.5 font-medium\"\n                    >\n                      \n                    </NavigationMenuLink>\n                  </NavigationMenuItem>\n                \n              </NavigationMenuList>\n            </NavigationMenu>\n            \n            <SettingsMenu />\n          </div>\n          \n          <UserMenu />\n        </div>\n      </div>\n    </header>\n</template>\n"
