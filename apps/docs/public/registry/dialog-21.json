         <span>New folder</span>\n              <CommandShortcut class=\"justify-center\">⌘N</CommandShortcut>\n            </CommandItem>\n            <CommandItem>\n               <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"opacity-60\"><circle cx=\"12\" cy=\"12\" r=\"9\" /></svg>\n              <span>Import document</span>\n              <CommandShortcut class=\"justify-center\">⌘I</CommandShortcut>\n            </CommandItem>\n            <CommandItem>\n               <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"opacity-60\"><circle cx=\"12\" cy=\"12\" r=\"9\" /></svg>\n              <span>Add block</span>\n              <CommandShortcut class=\"justify-center\">⌘B</CommandShortcut>\n            </CommandItem>\n          </CommandGroup>\n          <CommandSeparator />\n          <CommandGroup heading=\"Navigation\">\n            <CommandItem>\n               <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"opacity-60\"><circle cx=\"12\" cy=\"12\" r=\"9\" /></svg>\n              <span>Go to dashboard</span>\n            </CommandItem>\n            <CommandItem>\n               <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"opacity-60\"><circle cx=\"12\" cy=\"12\" r=\"9\" /></svg>\n              <span>Go to apps</span>\n            </CommandItem>\n            <CommandItem>\n               <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"opacity-60\"><circle cx=\"12\" cy=\"12\" r=\"9\" /></svg>\n              <span>Go to connections</span>\n            </CommandItem>\n          </CommandGroup>\n        </CommandList>\n      </CommandDialog>\n</template>\n"
    },
