      "content": "<view class=\"space-y-4\">\n  <view class=\"text-xl font-bold\">W/ sub-header and plus-minus</view>\n  <accordion type=\"single\" collapsible class=\"w-full\" bind:change=\"handleValueChange\" value=\"{{value}}\">\n    <block wx:for=\"{{items}}\" wx:key=\"id\" wx:for-index=\"itemIndex\" wx:for-item=\"item\">\n      <accordion-item value=\"{{item.id}}\" class=\"py-2\">\n        <view slot=\"trigger\" class=\"focus-visible:border-ring focus-visible:ring-ring/50 flex flex-1 items-center justify-between rounded-md py-2 text-left text-[15px] leading-6 font-semibold transition-all outline-none focus-visible:ring-[3px] [&>svg>path:last-child]:origin-center [&>svg>path:last-child]:transition-all [&>svg>path:last-child]:duration-200 [&[data-state=open]>svg]:rotate-180 [&[data-state=open]>svg>path:last-child]:rotate-90 [&[data-state=open]>svg>path:last-child]:opacity-0\">\n          <view class=\"flex flex-col space-y-1\">\n            <text>{{item.title}}</text>\n            <text wx:if=\"{{item.sub}}\" class=\"text-sm font-normal\">{{item.sub}}</text>\n          </view>\n        </view>\n        <view slot=\"icon\" class=\"h-4 w-4 shrink-0 opacity-60 transition-transform duration-200\">\n          <text class=\"text-sm font-semibold\">+</text>\n        </view>\n<view slot=\"content\" class=\"text-muted-foreground pb-2\">{{item.content}}</view>\n      </accordion-item>\n    </block>\n  </accordion>\n</view>"
