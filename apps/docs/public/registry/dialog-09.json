width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"size-4 opacity-60\"><circle cx=\"12\" cy=\"12\" r=\"9\" /></svg>\n              </div>\n            </div>\n          </div>\n          <Button type=\"button\" class=\"w-full\">\n            Subscribe\n          </Button>\n        </form>\n\n        <p class=\"text-muted-foreground text-center text-xs\">\n          By subscribing you agree to our \n          <a class=\"underline hover:no-underline\" href=\"#\">\n            Privacy Policy\n          </a>\n          .\n        </p>\n      </DialogContent>\n    </Dialog>\n</template>\n"
