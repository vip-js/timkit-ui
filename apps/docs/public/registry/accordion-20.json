ible-up data-[state=open]:animate-collapsible-down mt-1 overflow-hidden ps-6 text-sm transition-all\"\n                  data-collapsible-content\n                  data-state=\"closed\"\n                  style=\"height: 0; overflow: hidden;\"\n                >\n                  Our documentation is comprehensive and includes live examples for every component.\n                </div>\n              </div>\n          </div>\n    </div>\n  </div>\n  <div class=\"has-focus-visible:border-ring has-focus-visible:ring-ring/50 outline-none has-focus-visible:ring-[3px]\" data-accordion-item data-value=\"2\" data-state=\"closed\">\n    <button class=\"justify-start gap-3 rounded-md text-[15px] leading-6 outline-none hover:no-underline focus-visible:ring-0 [&>svg]:-order-1\" type=\"button\" data-accordion-trigger aria-expanded=\"false\">\n      <svg\n  class=\"h-4 w-4 shrink-0 opacity-60 transition-transform duration-200\"\n  data-accordion-icon\n  data-icon-type=\"chevron\"\n  aria-hidden=\"true\"\n  viewBox=\"0 0 24 24\"\n  fill=\"none\"\n  stroke=\"currentColor\"\n  stroke-width=\"2\"\n  stroke-linecap=\"round\"\n  stroke-linejoin=\"round\"\n  style=\"transform: rotate(0deg);\"\n>\n  <polyline points=\"6 9 12 15 18 9\"></polyline>\n</svg>\n      <span class=\"flex items-center gap-3\">\n        <span class=\"text-[10px] uppercase opacity-60\">Ecl</span>\n        <span>How can I customize the components?</span>\n      </span>\n    </button>\n    <div\n      class=\"p-0\"\n      data-accordion-content\n      data-state=\"closed\"\n      style=\"height: 0; overflow: hidden; padding-bottom: 0;\"\n    >\n      <div data-collapsible-root>\n            <div class=\"border-t py-3 ps-6 pe-4\">\n                <button\n                  class=\"flex gap-2 text-[15px] leading-6 font-semibold [&[data-state=open]>svg]:rotate-180\"\n                  type=\"button\"\n                  data-collapsible-trigger\n                  aria-expanded=\"false\"\n                >\n           