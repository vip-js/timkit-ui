st\" size=\"sm\" class=\"text-sm\">\n            <a href=\"#\">Community</a>\n          </Button>\n          <Button asChild size=\"sm\" class=\"text-sm\">\n            <a href=\"#\">Get Started</a>\n          </Button>\n          <ThemeToggle />\n        </div>\n      </div>\n    </header>\n</template>\n"
