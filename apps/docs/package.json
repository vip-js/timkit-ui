{
  "name": "@timui/docs",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "rimraf .next ../../.next ../../.turbo && pnpm registry:build:all && pnpm registry:manifest && pnpm previews:manifest",
    "dev": "next dev --turbopack -p 3001",
    "build": "pnpm registry:build:all && pnpm registry:manifest && pnpm previews:manifest && pnpm format:write && pnpm verify:data && next build",
    "registry:build": "shadcn build",
    "registry:build:all": "node --import tsx ../../scripts/build-registry-all.ts",
    "registry:manifest": "node ../../scripts/generate-docs-registry-manifest.cjs",
    "previews:manifest": "node ../../scripts/generate-docs-previews-manifest.cjs",
    "start": "next start",
    "lint": "eslint \"*.{js,jsx,ts,tsx}\" app components config hooks lib previews registry types utils --ext .js,.jsx,.ts,.tsx --no-warn-ignored",
    "lint:fix": "eslint \"*.{js,jsx,ts,tsx}\" app components config hooks lib previews registry types utils --ext .js,.jsx,.ts,.tsx --no-warn-ignored --fix",
    "catalog:build": "node --import tsx ../../scripts/build-registry-all.ts",
    "verify:data": "node --import tsx ../../scripts/check-registry-data.ts",
    "tokens:build": "node --import tsx ../../packages/tokens/build.ts",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headless-tree/core": "^1.0.0",
    "@headless-tree/react": "^1.0.0",
    "@heroicons/react": "^2.2.0",
    "@internationalized/date": "^3.7.0",
    "@markdoc/markdoc": "^0.5.4",
    "@origin-space/image-cropper": "^0.1.8",
    "@remixicon/react": "^4.6.0",
    "@tanstack/react-table": "^8.21.2",
    "@timui/core": "workspace:*",
    "@timui/react": "workspace:*",
    "@zag-js/react": "^1.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.16.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "input-otp": "^1.4.2",
    "jotai": "^2.12.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.509.0",
    "next": "^15.2.4",
    "next-mdx-remote": "^5.0.0",
    "next-themes": "^0.4.6",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-aria": "^3.38.1",
    "react-aria-components": "^1.7.1",
    "react-day-picker": "^9.6.4",
    "react-dom": "^19.1.0",
    "react-intersection-observer": "^9.16.0",
    "react-payment-inputs": "^1.2.0",
    "react-phone-number-input": "^3.4.12",
    "react-resizable-panels": "^2.1.7",
    "shadcn": "^2.3.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.1.0",
    "ts-morph": "^25.0.1",
    "tsx": "^4.19.3",
    "use-mask-input": "^3.4.2",
    "viewport": "^2.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@tailwindcss/postcss": "^4.1.1",
    "@types/node": "^22.13.17",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/react-payment-inputs": "^1.1.4",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.0.1",
    "shiki": "^2.5.0",
    "tailwindcss": "^4.1.1",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.8.2"
  }
}
