{
  "name": "vue-preview-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/generate-vue-ui-token-entries.cjs",
    "prebuild": "node ../../scripts/generate-vue-ui-token-entries.cjs",
    "dev": "vite --force --host 127.0.0.1 --port 3003",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3003 --strictPort"
  },
  "dependencies": {
    "@timui/core": "workspace:*",
    "@timui/html": "workspace:*",
    "@timui/tokens": "workspace:*",
    "@timui/vue": "workspace:*",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "tailwindcss": "^4.1.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vite": "^6.0.7"
  }
}
