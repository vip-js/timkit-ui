<root-portal wx:if="{{!contentApi.hidden}}">
    <!-- Simplified Popover content: Centered or Fixed near bottom if sheet-like -->
    <!-- For popover, we often want it near trigger. -->
    <!-- But implementing anchor positioning in WeApp is complex. -->
    <!-- We'll use fixed centering for now as fallback. -->
    <view 
        class="z-50 w-72 rounded-md border bg-popover p-4 text-popover-foreground shadow-md outline-none data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 {{contentApi.className}}"
        id="{{contentApi.id}}"
        role="dialog"
        aria-modal="true"
        data-state="{{contentApi['data-state']}}"
        data-side="{{contentApi['data-side']}}"
        style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); {{contentApi.style}}" 
    >
        <slot />
    </view>
</root-portal>
