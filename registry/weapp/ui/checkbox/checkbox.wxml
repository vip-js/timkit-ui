<label 
  class="inline-flex items-center justify-center {{api.rootProps.className}}"
  id="{{api.rootProps.id}}"
  bindtap="handleClick"
  data-state="{{api.rootProps['data-state']}}"
  data-disabled="{{api.rootProps['data-disabled']}}"
>
  <view 
    class="h-4 w-4 shrink-0 rounded-sm border border-primary ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=checked]:text-primary-foreground"
    data-state="{{api.controlProps['data-state']}}"
  >
     <block wx:if="{{api.checked}}">
        <!-- Check Icon (Lucide-like) -->
        <view class="flex items-center justify-center h-full">
            <view style="width: 10px; height: 10px; background: currentColor; clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);"></view>
        </view>
     </block>
  </view>
  <text class="ml-2 text-sm" wx:if="{{api.labelProps}}">
    <slot />
  </text>
  <input hidden value="{{api.hiddenInputProps.value}}" />
</label>
