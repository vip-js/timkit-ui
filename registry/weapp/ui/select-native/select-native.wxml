<picker 
  class="{{className}}" 
  bindchange="onChange" 
  value="{{value}}" 
  range="{{options}}" 
  range-key="{{rangeKey}}"
  disabled="{{disabled}}"
  mode="{{mode}}"
>
  <view class="flex h-10 w-full items-center justify-between rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50">
    <view class="flex-1 text-left">
      <block wx:if="{{displayValue}}">{{displayValue}}</block>
      <block wx:else><text class="text-muted-foreground">{{placeholder}}</text></block>
    </view>
    <view class="h-4 w-4 opacity-50">
      <svg width="100%" height="100%" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </view>
  </view>
</picker>
