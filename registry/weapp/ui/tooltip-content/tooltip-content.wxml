<root-portal wx:if="{{!contentApi.hidden}}">
    <!-- Tooltip also using fixed centering fallback or top/bottom? -->
    <!-- Tooltip is usually small. -->
    <view 
        class="z-50 overflow-hidden rounded-md border bg-popover px-3 py-1.5 text-sm text-popover-foreground shadow-md animate-in fade-in-0 zoom-in-95 data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=closed]:zoom-out-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2 {{contentApi.className}}"
        id="{{contentApi.id}}"
        data-state="{{contentApi['data-state']}}"
        style="position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); {{contentApi.style}}" 
    >
        <slot />
    </view>
</root-portal>
